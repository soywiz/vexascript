      <p class="eyebrow">JavaScript FFI</p>
      <h2>Declare an ABI for Deno</h2>
      <p class="lead"><code>@FFILibrary</code> accepts ordered library candidates, <code>@FFIName</code> maps friendly method names to exported symbols, and <code>@FFIStruct</code>, <code>FFIPointer</code>, and <code>ArrayBuffer</code> cover foreign memory. A <code>Promise&lt;T&gt;</code> return marks the call as nonblocking.</p>
    </div>
{% highlightVexaScript %}
@FFILibrary("libSDL2-2.0.so.0", "SDL2.framework/SDL2")
declare class SDL2 {
  @FFIName("SDL_Init")
  static func Init(flags: int): int

  @FFIName("SDL_Delay")
  static func Delay(milliseconds: int): Promise<void>
}
{% endhighlightVexaScript %}
