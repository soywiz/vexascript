<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>

    {% set description = "Learn VexaScript through syntax guides, examples, and embedded Monaco editors." %}
    {% set currentUrl = page.url or "/" %}
    {% set ogUrl = currentUrl | replace(".html", "") %}

    <meta name="description" content="{{ description }}">

    <meta property="og:title" content="VexaScript">
    <meta property="og:description" content="{{ description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://vexa.soywiz.com{{ ogUrl }}">
    <meta property="og:image" content="https://vexa.soywiz.com/banner.jpg">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="VexaScript">
    <meta name="twitter:description" content="{{ description }}">

    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="{{ generatedAssetHrefs.siteCss }}">
    <link rel="stylesheet" href="{{ generatedAssetHrefs.generatedStyleCss }}">
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">
          <img class="brand-icon" src="/favicon.svg" alt="" aria-hidden="true">
          <span>VexaScript</span>
        </a>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
          <span class="nav-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
          <span class="visually-hidden">Toggle navigation menu</span>
        </button>
        <nav id="primary-navigation" class="nav" aria-label="Primary navigation">
          <a href="/blog"{% if currentUrl.startsWith("/blog") %} aria-current="page"{% endif %}>Blog</a>
          <a href="/quickstart"{% if currentUrl.startsWith("/quickstart") %} aria-current="page"{% endif %}>Quickstart</a>
          <a href="/syntax"{% if currentUrl.startsWith("/syntax") %} aria-current="page"{% endif %}>Syntax</a>
          <a href="/config"{% if currentUrl.startsWith("/config") %} aria-current="page"{% endif %}>Config</a>
          <a href="/samples"{% if currentUrl.startsWith("/samples") %} aria-current="page"{% endif %}>Samples</a>
          <a href="/playground"{% if currentUrl.startsWith("/playground") %} aria-current="page"{% endif %}>Playground</a>
          <a href="/cli"{% if currentUrl.startsWith("/cli") %} aria-current="page"{% endif %}>CLI</a>
          <a href="/embed"{% if currentUrl.startsWith("/embed") %} aria-current="page"{% endif %}>Embed</a>
        </nav>
      </div>
    </header>
    <main>{{ content | safe }}</main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <a class="footer-brand" href="/">
          <img class="brand-icon" src="/favicon.svg" alt="" aria-hidden="true">
          <span>VexaScript</span>
        </a>
        <p>© {% year %} Soywiz Software. Built with 11ty and Monaco.</p>
      </div>
    </footer>
    <script
      src="{{ generatedAssetHrefs.generatedEmbedJs }}"
      onload="if (window.VexaScriptEmbeds) window.dispatchEvent(new Event('vexa-embeds-ready'))"
    ></script>
    <script>
      (function () {
        var toggle = document.querySelector(".nav-toggle");
        if (!toggle) return;

        toggle.addEventListener("click", function () {
          var expanded = toggle.getAttribute("aria-expanded") === "true";
          toggle.setAttribute("aria-expanded", expanded ? "false" : "true");
        });

        window.matchMedia("(min-width: 981px)").addEventListener("change", function (event) {
          if (event.matches) toggle.setAttribute("aria-expanded", "false");
        });
      })();
    </script>
  </body>
</html>
