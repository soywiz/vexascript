<section class="section">
  <div class="section-heading">
    <p class="eyebrow">Samples</p>
    <h1>Patterns to learn VexaScript</h1>
    <p class="lead">Focused VexaScript snippets covering operator overloads, indexers, property references, delegates, sync functions, ranges, extensions, and more.</p>
  </div>

  <h2 class="samples-group-heading">Classes &amp; Objects</h2>
  <div class="grid">
    <article class="card">
      <h3>Operator overloading</h3>
      <p>Operator and method overloading and new-less constructions, for concise writing.</p>
{% highlightVexaScript %}
class Vec2(val x: number, val y: number) {
  operator+(other: Vec2) => Vec2(x + other.x, y + other.y)
  operator-(other: Vec2) => Vec2(x - other.x, y - other.y)
}
Vec2(1, 2) + Vec2(3, 4)
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Index operator overloads</h3>
      <p>Classes can overload <code>[]</code> and <code>[]=</code> with one or more index arguments, including rest dimensions.</p>
{% highlightVexaScript %}
class Grid<T> {
  var data: T[] = []

  operator[](x: int, y: int): T {
    return data[y * 10 + x]
  }

  operator[]=(value: T, x: int, y: int) {
    data[y * 10 + x] = value
  }
}

class PathKey {
  operator[](...dimensions: int[]): string {
    return dimensions.join(":")
  }
}

val grid = Grid<string>()
grid[2, 4] = "selected"
val cell = grid[2, 4]
val key = PathKey()[2, 4, 8]
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>JSX with Preact</h3>
      <p>Typed prop destructuring stays concise, while a delegated <code>useState</code> tuple turns mutable state into direct reads and assignments.</p>
{% highlightVexaScript %}
import { h } from "preact"
import { useState } from "preact/hooks"

fun Counter({ initial: number }) {
  var count by useState(initial)

  return <button onClick={ { count++ } }>
    Count: {count}
  </button>
}
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Implicit property access</h3>
      <p>When no ambiguity happens, <code>this</code> is optional.</p>
{% highlightVexaScript %}
class Counter(var value: int) {
  fun increment(): int => ++value
}
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Class delegates</h3>
      <p>Satisfy an interface by forwarding its members to another value using <code>by</code>.</p>
{% highlightVexaScript %}
interface Shape {
  area: number
  fill(color: string): string
}

class Rectangle(val width: number, val height: number) : Shape {
  area => width * height
  fill(color: string) => `${color}:${width}x${height}`
}

class ShapeLogger(val shape: Shape, val label: string) : Shape by { shape } {
  describe() => `${label}: area=${area}`
}
{% endhighlightVexaScript %}
    </article>
  </div>

  <h2 class="samples-group-heading">Delegated Properties</h2>
  <div class="grid">
    <article class="card">
      <h3>Tuple delegate</h3>
      <p>A <code>[value, setter]</code> tuple delegate wires reads and writes through custom accessors — like React's <code>useState</code>.</p>
{% highlightVexaScript %}
fun useState(value: number) {
  return [() => value, (newValue: number) => { value = newValue }]
}

var count by useState(0)
count = count + 1
count += 1
count++
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Object &amp; function delegates</h3>
      <p>A <code>{ value }</code> object or a zero-argument function also work as delegates — all assignments route through the accessor.</p>
{% highlightVexaScript %}
fun box<T>(initial: T) {
  return { value: initial }
}

var source = 1
var observed by () => source   // function delegate: reads source
var total by box(0)            // object delegate: reads/writes .value

total = observed + 2
source = 5
total += observed
total++
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Property references</h3>
      <p><code>expr::field</code> creates a live <code>Property&lt;T&gt;</code> reference with <code>name</code> and <code>value</code>, so it works with delegates and APIs that animate or bind properties.</p>
{% highlightVexaScript %}
class Slider(var x: number)

class TweenTarget(val property: Property<number>, val src: number, val dst: number)

fun Property<number>.operator[](src: number, dst: number): TweenTarget {
  return TweenTarget(this, src, dst)
}

fun tween(target: TweenTarget) {
  target.property.value = target.dst
}

val slider = Slider(5)
val xRef = slider::x
var x by xRef

x += 10
tween(slider::x[0, 100])

console.log(`${xRef.name}:${xRef.value}`)
{% endhighlightVexaScript %}
    </article>
  </div>

  <h2 class="samples-group-heading">Async &amp; Sync</h2>
  <div class="grid">
    <article class="card">
      <h3>Sync functions</h3>
      <p><code>sync</code> functions auto-await any <code>Promise</code>-typed expression. Write sequential code without explicit <code>await</code>.</p>
{% highlightVexaScript %}
sync fun fetchPrice(item: string): number {
  return fetch(`/prices/${item}`).json()
}

sync fun checkout(): number {
  const base = fetchPrice("book")   // auto-awaited
  const tax = fetchPrice("tax")     // auto-awaited
  return base + tax
}
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>The <code>go</code> operator</h3>
      <p>Inside a <code>sync</code> function, prefix an expression with <code>go</code> to keep the raw <code>Promise</code> instead of auto-awaiting it.</p>
{% highlightVexaScript %}
sync fun main(): void {
  // fire-and-forget — result Promise kept, not awaited
  const pending: Promise<number> = go fetchPrice("audit")

  // normal sync call — awaited automatically
  const price = fetchPrice("book")

  console.log(price)
  console.log(await pending)
}
{% endhighlightVexaScript %}
    </article>
  </div>

  <h2 class="samples-group-heading">Control Flow</h2>
  <div class="grid">
    <article class="card">
      <h3>Defer</h3>
      <p><code>defer</code> schedules cleanup for the end of the block — it runs even when the block returns early or throws.</p>
{% highlightVexaScript %}
fun readValue(): int {
  console.log("open")
  defer console.log("close-2")
  defer console.log("close-1")
  console.log("read")
  return 7
}
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Range expressions</h3>
      <p><code>...</code> is end-inclusive; <code>..<</code> is end-exclusive. Both work directly in <code>for-of</code> loops and as values.</p>
{% highlightVexaScript %}
for (n of 0 ..< 5) {
  console.log(n)    // 0, 1, 2, 3, 4
}

for (n of 1 ... 5) {
  console.log(n)    // 1, 2, 3, 4, 5
}
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Array comprehensions</h3>
      <p>Put a <code>for-of</code> or <code>for-in</code> header inside brackets to collect a typed result array without a temporary accumulator.</p>
{% highlightVexaScript %}
val doubled = [for (value of [1, 2, 3]) value * 2]
val normal = [for (n in 0 ..< 10) n]
val labels = [for (val [name, score] of entries) "$name:$score"]
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Cascade operator</h3>
      <p><code>..</code> keeps applying member operations to the same receiver and then returns that receiver, which is handy for configuration-style code.</p>
{% highlightVexaScript %}
val badge = new Graphics()
  ..point = Vec2(centerX, centerY - 16)
  ..beginFill(0xff6b35)
  ..drawRoundedRect(-110, -64, 220, 128, 28)
  ..endFill()
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Postfix receiver blocks</h3>
      <p><code>value. { ... }</code> evaluates a value once, makes it the implicit receiver inside the block, and returns that same value for grouped configuration and mutation.</p>
{% highlightVexaScript %}
val badge = new Graphics(). {
  point = Vec2(centerX, centerY - 16)
  beginFill(0xff6b35)
  drawRoundedRect(-110, -64, 220, 128, 28)
  endFill()
}
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Smart casts</h3>
      <p><code>is</code> keeps nominal <code>instanceof</code> behavior for classes and also accepts primitive, literal, object, array, regular-expression, relational, <code>and</code>, and <code>or</code> patterns.</p>
{% highlightVexaScript %}
class Cat { meow() {} }
class Dog { bark() {} }

fun greet(animal: Cat | Dog) {
  if (animal is Cat) {
    animal.meow()   // type narrowed to Cat here
  } else {
    animal.bark()   // type narrowed to Dog here
  }
}

fun greetWithInstanceof(animal: Cat | Dog) {
  if (animal instanceof Cat) {
    animal.meow()  // same smart cast as `is`
  }
}

fun clamp(value: int | string) {
  if (value in 0 ... 100) {
    const safe: int = value
  }
}
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Subject match and bindings</h3>
      <p>A subject is evaluated once. <code>val name</code> captures a matched value; <code>val name: Type</code> checks and captures it with a branch-local type.</p>
{% highlightVexaScript %}
fun describe(packet: any): string {
  return match (packet) {
    { kind: "ok", payload: [val first: string, ...] } ->
      "first=" + first
    [string, val count: number, 3] ->
      "count=" + count
    else -> "unknown"
  }
}
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Composable matcher patterns</h3>
      <p>Use literals, primitive types, regular expressions, open array shapes, relational checks, and <code>and</code>/<code>or</code>. The compact arrow form omits <code>when</code>; the colon form requires it.</p>
{% highlightVexaScript %}
val label = match (value) {
  /^user-[0-9]+$/i -> "user id"
  >= 10 and < 20 -> "teen"
  "ready" or "running" -> "active"
  string -> "other text"
  else -> "unknown"
}

if (value is ({ kind: "ok" } and { payload })) {
  console.log(value.payload)
}
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Tail lambdas</h3>
      <p>A lambda after the closing parenthesis — or as the only argument — follows Kotlin/Swift style and reduces visual noise.</p>
{% highlightVexaScript %}
val doubled = [1, 2, 3].map { it * 2 }

val even = [1, 2, 3, 4].filter { it % 2 == 0 }

val result = [1, 2, 3].map {
  const tripled = it * 3
  tripled + 1   // implicit return
}
{% endhighlightVexaScript %}
    </article>
  </div>

  <h2 class="samples-group-heading">Extensions &amp; Calls</h2>
  <div class="grid">
    <article class="card">
      <h3>Extension properties</h3>
      <p>Add read-only properties to existing types. Import them where needed; access without an import is an error.</p>
{% highlightVexaScript %}
class Duration(val milliseconds: number)

val number.milliseconds => Duration(this)
val number.seconds: Duration => Duration(this * 1000)
val number.minutes: Duration => Duration(this * 60_000)

val d1 = 500.milliseconds
val d2 = 2.seconds
val d3 = 1.minutes
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Receiver functions</h3>
      <p>Generic receiver functions can accept a block that operates on the receiver and returns it for fluent calls.</p>
{% highlightVexaScript %}
fun <T> T.apply(block: T.() => T) { block(this); return this }

class Point(var x: number, var y: number)

val point = Point(10, 20).apply {
  x = y * 2
  this
}
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Generic extension methods</h3>
      <p>Extension methods can be generic and work with built-in collection types like <code>Array&lt;T&gt;</code>.</p>
{% highlightVexaScript %}
fun <T> Array<T>.second(): T => this[1]
val <T> Array<T>.doubledLength => length * 2

val xs = [10, 20, 30]
console.log(xs.second())        // 20
console.log(xs.doubledLength)   // 6
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Named arguments</h3>
      <p>Pass arguments by parameter name in any order. The compiler reorders them to match the callee's parameter list.</p>
{% highlightVexaScript %}
fun connect(host: string, port: number, tls: boolean = false) {}

connect(port: 8080, host: "localhost")
connect("localhost", port: 8080, tls: true)

class Point(val x: number, val y: number)
val p = Point(y: 2, x: 1)
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Function overloads</h3>
      <p>Multiple functions can share the same name when their parameter types differ. The compiler picks the right one at each call site.</p>
{% highlightVexaScript %}
function describe(value: int): string { return "int:" + value }
function describe(value: string): string { return "str:" + value }

console.log(describe(42))       // "int:42"
console.log(describe("hello"))  // "str:hello"
{% endhighlightVexaScript %}
    </article>
  </div>

  <h2 class="samples-group-heading">Native &amp; Interop</h2>
  <div class="grid">
    <article class="card">
      <h3>Cross-backend FFI</h3>
      <p>Declare a C ABI once and try platform library candidates in order. The same typed call uses Deno FFI or the native C++ runtime.</p>
{% highlightVexaScript %}
@FFILibrary("libSystem.B.dylib", "libc.so.6", "msvcrt.dll")
declare class NativeC {
  static abs(value: int): int
}

val distance = NativeC.abs(-42)
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Renamed FFI symbols</h3>
      <p><code>@FFIName</code> maps a clean VexaScript method name to the exported C symbol without changing call sites.</p>
{% highlightVexaScript %}
@FFILibrary("SDL2.dll", "libSDL2.so", "SDL2.framework/SDL2")
declare class SDL2 {
  @FFIName("SDL_Init")
  static Init(flags: int): int
}

val status = SDL2.Init(32)
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>FFI struct layouts</h3>
      <p><code>@FFIStruct</code> creates an <code>ArrayBuffer</code>-backed ABI layout. Alignment, offsets, and field sizes remain explicit and portable.</p>
{% highlightVexaScript %}
@FFIStruct(16)
@FFIAlign(4)
class Rect(
  @FFIOffset(0) @FFISize(4) var x: int = 0,
  @FFIOffset(4) @FFISize(4) var y: int = 0,
  @FFIOffset(8) @FFISize(4) var width: int = 0,
  @FFIOffset(12) @FFISize(4) var height: int = 0
)

val rect = Rect(x: 10, y: 20, width: 320, height: 180)
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>FFI pointers &amp; buffers</h3>
      <p><code>FFIPointer</code> exposes typed memory access, while <code>ArrayBuffer</code> arguments pass their backing bytes without a copy.</p>
{% highlightVexaScript %}
@FFILibrary("libSystem.B.dylib", "libc.so.6", "msvcrt.dll")
declare class NativeMemory {
  static malloc(size: long): FFIPointer
  static memset(bytes: ArrayBuffer, value: int, size: long): FFIPointer
  static free(pointer: FFIPointer): void
}

val pointer = NativeMemory.malloc(8L)
pointer.setInt32(0, 1234)

val bytes = ArrayBuffer(4)
NativeMemory.memset(bytes, 65, 4L)
NativeMemory.free(pointer)
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Nonblocking FFI calls</h3>
      <p>A foreign method returning <code>Promise&lt;T&gt;</code> runs without blocking the main event loop and works naturally inside a <code>sync</code> function.</p>
{% highlightVexaScript %}
@FFILibrary("SDL2.dll", "libSDL2.so", "SDL2.framework/SDL2")
declare class SDL2Async {
  @FFIName("SDL_Delay")
  static Delay(milliseconds: int): Promise<void>
}

sync fun nextFrame(): void {
  SDL2Async.Delay(16)
}
{% endhighlightVexaScript %}
    </article>
  </div>
</section>
