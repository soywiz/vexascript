<section class="page-hero">
  <p class="eyebrow">Embedding API</p>
  <h1>Embedding VexaScript in your own pages</h1>
</section>

<section class="doc-shell">
  <p class="lead">Use the following snippets to embed a single-file editor, a multi-tab editor, or a full workbench with a workspace tree and toolbar directly into tutorials, docs, and demos.</p>
  <p class="lead">Embeds also support an <code>inlayHints</code> flag so each host can turn hints on or off, while workbench embeds additionally support <code>allowWorkspaceWrites</code> to enable or disable editing, saving, and workspace mutations plus a reset button that restores the original embedded files.</p>
  <div class="embed-docs">
    <article class="card">
      <h3>Simple editor</h3>
{% highlightVexaScript %}
<div id="lesson-editor"></div>
<script src="https://vexa.soywiz.com/assets/generated/vexa-embed.js"></script>
<script>
  VexaScriptEmbeds.createSimpleEditor("#lesson-editor", {
    content: "fun add(a: int, b: int): int { return a + b }",
    inlayHints: false
  })
</script>
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Workspace editor</h3>
{% highlightVexaScript %}
<div id="lesson-editor"></div>
<script src="https://vexa.soywiz.com/assets/generated/vexa-embed.js"></script>
<script>
VexaScriptEmbeds.createWorkspaceEditor("#workspace", {
  activePath: "/main.vx",
  files: [
    { path: "/main.vx", content: "import { greet } from './greeter.vx'\nconsole.log(greet('VexaScript'))" },
    { path: "/greeter.vx", content: "export fun greet(name: string): string { return $\"Hello {name}\" }" }
  ]
})
</script>
{% endhighlightVexaScript %}
    </article>
    <article class="card">
      <h3>Full workbench</h3>
{% highlightVexaScript %}
<div id="lesson-editor"></div>
<script src="https://vexa.soywiz.com/assets/generated/vexa-embed.js"></script>
<script>
VexaScriptEmbeds.createWorkbenchEditor("#workbench", {
  activePath: "/src/main.vx",
  allowWorkspaceWrites: true,
  inlayHints: true,
  files: [
    { path: "/src/main.vx", content: "import { greet } from './greeter.vx'\nconsole.log(greet('VexaScript'))" },
    { path: "/src/greeter.vx", content: "export fun greet(name: string): string => $\"Hello {name}\"" }
  ]
})
</script>
{% endhighlightVexaScript %}
    </article>
  </div>
</section>

<section class="section alt">
  <div style="display:grid;grid-template-columns: repeat(2, 1fr); grid-gap: 10px;">
    <div class="editor-shell">
      <div class="panel-title">Single-file snippet</div>
      <div id="simple-editor" class="editor-demo"></div>
    </div>
    <div class="editor-shell">
      <div class="panel-title">Multi-file workspace</div>
      <div id="workspace-editor" class="workspace-demo"></div>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="editor-shell">
    <div class="panel-title">Full workbench</div>
    <div id="workbench-editor" class="workbench-demo"></div>
  </div>
</section>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    function withEmbeds(callback) {
      if (window.VexaScriptEmbeds) {
        callback(window.VexaScriptEmbeds)
        return
      }
      window.addEventListener("vexa-embeds-ready", () => {
        if (!window.VexaScriptEmbeds) {
          throw new Error("VexaScriptEmbeds finished loading without exposing the expected API")
        }
        callback(window.VexaScriptEmbeds)
      }, { once: true })
    }

    function dedent(strings, ...values) {
      const raw = String.raw({ raw: strings }, ...values).replace(/^\n+/, "")
      const lines = raw.split("\n")
      const indents = lines
        .filter((line) => line.trim() !== "")
        .map((line) => line.match(/^\s*/)?.[0].length ?? 0)
      const margin = indents.length > 0 ? Math.min(...indents) : 0
      return lines.map((line) => line.slice(margin)).join("\n").trim()
    }
    const counterSnippet = dedent`
      class Counter(var value: int) {
        increment(): int => ++value
      }

      val counter = Counter(41)
      counter.increment()

      sync fun loadBytes(): Uint8Array {
        return Uint8Array(fetch("file.bin").arrayBuffer())
      }
    `
    const counterSelection = {
      startLineNumber: 4,
      startColumn: 5,
      endLineNumber: 4,
      endColumn: 22
    }

    withEmbeds((embeds) => {
      embeds.createSimpleEditor("#simple-editor", {
        content: counterSnippet,
        inlayHints: false,
        selection: counterSelection
      })

      embeds.createTabbedEditor("#workspace-editor", {
        activePath: "/main.vx",
        files: [
          {
            path: "/main.vx",
            content: counterSnippet
          },
          {
            path: "/notes.vx",
            content: `// Same snippet, same initial selection, different host shell.
// This workspace embed exists to compare the website integration against
// the standalone Monaco app using the exact same code sample.`
          }
        ],
        inlayHints: false,
        selection: counterSelection
      })

      embeds.createWorkbenchEditor("#workbench-editor", {
        activePath: "/src/main.vx",
        allowWorkspaceWrites: true,
        inlayHints: true,
        files: [
          {
            path: "/src/main.vx",
            content: dedent`
            import { increment } from "./counter.vx"

            val current = increment(41)
            console.log(current.toString())
          `
          },
          {
            path: "/src/counter.vx",
            content: dedent`
            export fun increment(value: int): int {
              return value + 1
            }
          `
          },
          {
            path: "/README.vx",
            content: "// Edit files, switch tabs, create new files, and format from the toolbar."
          }
        ]
      })
    })
  })
</script>
