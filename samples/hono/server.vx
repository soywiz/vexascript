import { serve } from "@hono/node-server"
import { Hono } from "hono"

type ServerEnvironment = {
  Variables: {
    requestId: string;
  };
}

const app = new Hono<ServerEnvironment>()
const port = 3000

app.use("*", async (context, next) => {
  context.set("requestId", `request-${Date.now()}`)
  await next()
  context.header("X-Request-Id", context.get("requestId"))
})

app.get("/", (context) => {
  return context.html(`<!doctype html>
<html lang="en">
  <head><meta charset="utf-8"><title>VexaScript + Hono</title></head>
  <body><h1>VexaScript + Hono</h1><p>Try <code>/api/users/7</code>.</p></body>
</html>`)
})

app.get("/api/users/:id", (context) => {
  return context.json({
    id: context.req.param("id"),
    requestId: context.get("requestId")
  })
})

app.post("/api/sum", async (context) => {
  const body = await context.req.json<{ values: number[] }>()
  return context.json({ total: body.values.reduce((total, value) => total + value, 0) })
})

serve({ fetch: app.fetch, port }, (info) => {
  console.log(`Hono listening on http://localhost:${info.port}`)
})
