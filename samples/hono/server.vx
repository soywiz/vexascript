import { serve } from "@hono/node-server"
import { Hono } from "hono"

type ServerEnvironment = {
  Variables: {
    requestId: string;
  };
}

func delay(ms: number) {
  return Promise { resolve, reject -> setTimeout(resolve, ms) }
}

func dedent(str: string): string {
  const lines = str
    .replace(/^\r?\n/, "")
    .replace(/\r?\n[ \t]*$/, "")
    .split(/\r?\n/)
  const indentation = lines.reduce((minimum, line) => {
    const current = line.search(/\S/)
    return current < 0 ? minimum : Math.min(minimum, current)
  }, Infinity)

  return lines.map((line) => line.slice(indentation)).join("\n")
}

const app = Hono<ServerEnvironment>()
const port = 3000

app.use("*") sync { context, next ->
  context.set("requestId", `request-${Date.now()}`)
  next()
  context.header("X-Request-Id", context.get("requestId"))
}

app.get("/") sync {
  return it.html(dedent`
    <!doctype html>
    <html lang="en">
      <head><meta charset="utf-8"><title>VexaScript + Hono</title></head>
      <body><h1>VexaScript + Hono</h1><p>Try <a href="/api/users/7"><code>/api/users/7</code></a>.</p></body>
    </html>
  `)
}

app.get("/api/users/:id") sync {
  delay(1000)
  return it.json({
    id: it.req.param("id"),
    requestId: it.get("requestId")
  })
}

app.post("/api/sum") sync { context ->
  const body = context.req.json<{ values: number[] }>()
  return context.json({ total: body.values.reduce((total, value) => total + value, 0) })
}

serve({ fetch: app.fetch, port }) {
  console.log(`Hono listening on http://localhost:${it.port}`)
}
