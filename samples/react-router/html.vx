import React from "react"
import ReactDOM from "react-dom"
import { Link, MemoryRouter, useLocation } from "react-router-dom"

fun ActiveRouteCard() {
  val location = useLocation()
  val pathname = location.pathname
  val title = match (pathname) {
    "/docs" -> "Docs"
    "/faq" -> "FAQ"
    else -> "Home"
  }
  val description = match (pathname) {
    "/docs" -> "The docs route shows the focused browser message."
    "/faq" -> "The FAQ route proves route state can drive JSX output."
    else -> "The sample booted with a typed in-memory router."
  }

  return (
    <article className="card">
      <span className="eyebrow">Active Route</span>
      <h2>{title}</h2>
      <p>{description}</p>
      <code>{pathname}</code>
    </article>
  )
}

fun pillClass(pathname: string, route: string): string {
  return match {
    pathname == route -> "pill pill-active"
    else -> "pill"
  }
}

fun App() {
  val location = useLocation()
  val pathname = location.pathname

  return (
    <main className="shell">
      <section className="hero">
        <span className="eyebrow">Router Sample</span>
        <h1>React Router + VexaScript</h1>
        <p>MemoryRouter, typed route objects, and JSX rendering all stay in the normal React shape.</p>
      </section>
      <nav className="nav">
        <Link className={pillClass(pathname, "/")} to="/">
          Home
        </Link>
        <Link className={pillClass(pathname, "/docs")} to="/docs">
          Docs
        </Link>
        <Link className={pillClass(pathname, "/faq")} to="/faq">
          FAQ
        </Link>
      </nav>
      <ActiveRouteCard />
    </main>
  )
}

val container = document.getElementById("app")
if (container == null) {
  throw Error("Missing #app root")
}

ReactDOM.render(
  <MemoryRouter initialEntries={["/docs"]}>
    <App />
  </MemoryRouter>,
  container!
)
console.log("react-router-sample-ready")
