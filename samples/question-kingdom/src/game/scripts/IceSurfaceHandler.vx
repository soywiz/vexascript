import { Component } from '../core/Component.vx';
import type { ContactContext } from '../core/PhysicsTypes.vx';
import type { Player } from '../entities/Player.vx';

export class IceSurfaceHandler extends Component {
  onPreSolve(context: ContactContext): void {
    if (context.other.kind === 'player') context.contact.SetFriction(0);
  }

  onPostSolve(context: ContactContext): void {
    if (context.other.kind !== 'player' || !context.contact.IsEnabled()) return;
    (context.other.owner as Player).controller.markOnIce();
  }
}
