import { SOUND_URLS } from '../art.vx';
import { AudioService } from '../core/AudioService.vx';
import { Component } from '../core/Component.vx';
import { PIXELS_PER_METER } from '../core/constants.vx';
import type { ContactContext } from '../core/PhysicsTypes.vx';
import { Rigidbody } from '../core/Rigidbody.vx';
import { CoinPickupParticles } from '../entities/CoinPickupParticles.vx';

export class CoinCollectHandler(
  private const homeY: number,
  private const phase: number,
) extends Component {
  private collected = false;
  private collectQueued = false;
  private elapsed = 0;

  onBeginContact(context: ContactContext): void {
    if (context.other.kind !== 'player' || collected || collectQueued) return;
    collectQueued = true;
    scene.defer(() => collect());
  }

  lateUpdate(delta: number): void {
    if (collected) return;
    elapsed += delta;
    gameObject.view.y = homeY * PIXELS_PER_METER + Math.sin(elapsed * 4 + phase) * 7;
    gameObject.view.scale.x = 0.72 + Math.abs(Math.cos(elapsed * 5 + phase)) * 0.28;
  }

  private collect(): void {
    if (collected) return;
    collected = true;
    const rigidbody = gameObject.getComponent(Rigidbody);
    const position = rigidbody?.body.GetPosition();
    if (position) new CoinPickupParticles(scene, position.x, position.y);
    rigidbody?.setEnabled(false);
    scene.events.emit('coinCollected', { amount: 1, points: 50 });
    AudioService.play(SOUND_URLS.coin);
  }
}
