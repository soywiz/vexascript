import { Component } from '../core/Component.vx';
import { PLAYER_HALF_HEIGHT, PLAYER_HALF_WIDTH } from '../core/constants.vx';
import type { ContactContext } from '../core/PhysicsTypes.vx';
import { Rigidbody } from '../core/Rigidbody.vx';

export class OneWayPlatformHandler extends Component {
  private dropThroughTimer = 0;

  update(delta: number): void {
    dropThroughTimer = Math.max(0, dropThroughTimer - delta);
  }

  onPreSolve(context: ContactContext): void {
    if (context.other.kind !== 'player') return;
    const dropRequested = scene.input.down('KeyS', 'ArrowDown')
      && scene.input.justPressed('Space', 'KeyW', 'ArrowUp');
    if (dropRequested) dropThroughTimer = 0.22;
    if (dropThroughTimer > 0) {
      context.contact.SetEnabled(false);
      return;
    }
    const playerBody = context.other.owner.getComponent(Rigidbody)?.body;
    if (!playerBody) return;
    const platformBody = context.selfFixture.GetBody();
    const angle = platformBody.GetAngle();
    const localPosition = platformBody.GetLocalPoint(playerBody.GetPosition(), { x: 0, y: 0 });
    const localVelocity = platformBody.GetLocalVector(playerBody.GetLinearVelocity(), { x: 0, y: 0 });
    const projectedHalfHeight = Math.abs(Math.sin(angle)) * PLAYER_HALF_WIDTH + Math.abs(Math.cos(angle)) * PLAYER_HALF_HEIGHT;
    const playerBottom = localPosition.y + projectedHalfHeight;
    const platformTop = -(context.self.halfHeight ?? 0.12);
    const crossingUpFromBelow = localVelocity.y < -0.05 && localPosition.y > platformTop - projectedHalfHeight * 0.25;
    if (playerBottom > platformTop + 0.09 || crossingUpFromBelow) {
      context.contact.SetEnabled(false);
    }
  }
}
