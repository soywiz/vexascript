import type { b2ContactImpulse } from '@box2d/core';
import { Component } from '../core/Component.vx';
import type { ContactContext } from '../core/PhysicsTypes.vx';
import type { BlockEnemy } from '../entities/BlockEnemy.vx';
import type { Player } from '../entities/Player.vx';

export class BlockCrushHandler extends Component {
  onBeginContact(context: ContactContext): void {
    tryCrush(context);
  }

  onPostSolve(context: ContactContext, _impulse: b2ContactImpulse): void {
    tryCrush(context);
  }

  private tryCrush(context: ContactContext): void {
    if (context.other.kind !== 'player') return;
    const block = gameObject as BlockEnemy;
    if (!block.crusher.crushing) return;
    const player = context.other.owner as Player;
    const blockY = block.rigidbody.body.GetPosition().y;
    const playerY = player.rigidbody.body.GetPosition().y;
    if (playerY > blockY + 0.3) player.controller.requestHurt();
  }
}
