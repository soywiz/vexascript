import { Coin } from '../entities/Coin.vx';
import { Bee } from '../entities/Bee.vx';
import { BlockEnemy } from '../entities/BlockEnemy.vx';
import { Enemy } from '../entities/Enemy.vx';
import { Frog } from '../entities/Frog.vx';
import { Goal } from '../entities/Goal.vx';
import { Ground } from '../entities/Ground.vx';
import { MovingPlatform } from '../entities/MovingPlatform.vx';
import { Platform } from '../entities/Platform.vx';
import { Player } from '../entities/Player.vx';
import { QuestionBlock } from '../entities/QuestionBlock.vx';
import { Wall } from '../entities/Wall.vx';
import { WaterZone } from '../entities/WaterZone.vx';
import type { GameScene } from '../core/GameScene.vx';

const GROUND_SEGMENTS = [
  [0, 17, 10.2],
  [20, 32, 10.2],
  [32, 38, 12.2],
  [38, 55, 10.2],
  [58, 86, 10.2],
] as const;

const WATER_ZONES = [
  [35.0, 7.15, 6.0, 5.05],
] as const;

const MOVING_PLATFORMS = [
  [22.0, 4.85, 2.6, 2.25, 4.4],
] as const;

const PLATFORMS = [
  [5.8, 8.0, 3.4, false], [11.2, 7.1, 3.2, true], [16.2, 8.35, 3.4, true],
  [19.0, 7.15, 2.6, true], [24.0, 8.15, 3.6, false, -0.18], [29.0, 6.65, 3.8, true],
  [40.0, 7.75, 3.8, false, -0.15], [46.2, 6.25, 4.3, true],
  [52.0, 8.1, 3.2, false, -0.2], [56.5, 6.8, 3.0, true],
  // Zigzag one-way ascent: right, left, right, left, then right.
  [60.0, 9.3, 4.0, true, -0.24], [60.0, 7.9, 4.0, true, 0.24, 'ice'],
  [60.0, 6.5, 4.0, true, -0.24], [60.0, 5.1, 4.0, true, 0.24, 'ice'],
  [60.0, 3.7, 4.0, true, -0.24], [64.0, 3.2, 3.2, true],
  [83.5, 1.42, 5.4, false],
] as const;

const WALLS = [
  [31.55, 10.2, 0.9, 2.7],
  [53.8, 10.2, 0.9, 3.25],
  // The tower's left wall is suspended to allow entry from below.
  [78.3, 8.0, 0.55, 6.8],
  [80.9, 10.2, 0.55, 9.0],
] as const;

const QUESTION_BLOCKS = [
  [8.2, 6.2], [9.15, 6.2], [26.5, 6.35], [31.2, 4.75], [42.0, 5.95],
  [48.1, 4.45], [64.5, 6.15], [70.1, 4.7], [76.6, 3.65],
] as const;

const COINS = [
  [3.8, 8.8], [5.8, 7.05], [11.2, 6.15], [14.9, 7.05], [16.2, 6.65], [17.6, 7.0],
  [18.8, 6.15], [22.1, 8.8], [24.0, 7.15], [28.2, 5.7], [29.8, 5.7], [34.7, 7.15],
  [35.8, 6.55], [36.9, 7.15], [40.0, 6.75], [45.0, 5.25], [46.4, 5.15], [47.8, 5.25],
  [33.4, 8.65], [35.0, 9.7], [36.6, 8.65], [35.0, 11.0],
  [51.9, 7.1], [55.2, 5.9], [56.4, 5.75], [57.6, 6.2], [61.0, 7.0], [67.1, 5.5],
  [61.4, 8.2], [58.6, 6.8], [61.4, 5.4], [58.6, 4.0], [61.4, 2.6],
  [68.5, 5.45], [69.9, 5.5], [74.5, 4.7], [79.0, 8.8], [79.6, 7.75], [79.6, 6.55],
  [79.6, 5.35], [79.6, 4.15], [79.6, 2.95], [79.6, 1.75], [82.2, 0.65], [83.4, 0.55],
] as const;

const ENEMIES = [
  [12.0, 9.3, 1], [23.5, 9.3, -1], [29.0, 5.85, 1], [41.0, 7.05, -1],
  [50.0, 9.3, -1], [62.0, 7.3, 1], [68.0, 5.75, -1], [73.0, 9.3, 1],
] as const;

const FROGS = [
  [15.0, 9.25, -1], [38.8, 9.25, 1], [69.0, 9.25, -1],
] as const;

const BEES = [
  [19.0, 6.0, 1, 2.2], [46.2, 3.4, -1, 1.5], [72.0, 6.1, 1, 2.4],
] as const;

const BLOCK_ENEMIES = [
  [43.0, 3.35],
] as const;

export class LevelBuilder(private const scene: GameScene) {
  build(): Player {
    GROUND_SEGMENTS.forEach(([fromX, toX, topY]) => new Ground(scene, fromX, toX, topY));
    WATER_ZONES.forEach(([x, surfaceY, width, height]) => new WaterZone(scene, x, surfaceY, width, height));
    PLATFORMS.forEach(([x, y, width, oneWay, angle = 0, material = 'grass']) => (
      new Platform(scene, x, y, width, oneWay, angle, material === 'ice' ? 'ice' : 'grass')
    ));
    MOVING_PLATFORMS.forEach(([x, surfaceY, width, travel, period]) => (
      new MovingPlatform(scene, x, surfaceY, width, travel, period)
    ));
    WALLS.forEach(([x, bottomY, width, height]) => new Wall(scene, x, bottomY, width, height));
    QUESTION_BLOCKS.forEach(([x, y]) => new QuestionBlock(scene, x, y));
    COINS.forEach(([x, y]) => new Coin(scene, x, y));
    ENEMIES.forEach(([x, y, direction]) => new Enemy(scene, x, y, direction));
    FROGS.forEach(([x, y, direction]) => new Frog(scene, x, y, direction));
    BEES.forEach(([x, y, direction, range]) => new Bee(scene, x, y, direction, range));
    BLOCK_ENEMIES.forEach(([x, y]) => new BlockEnemy(scene, x, y));
    new Goal(scene, 85.0, 1.21);
    return new Player(scene, 2.2, 8.9);
  }
}
