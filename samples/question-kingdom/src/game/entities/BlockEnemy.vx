import { b2BodyType } from '@box2d/core';
import { makeBlockEnemy } from '../art.vx';
import { GameObject } from '../core/GameObject.vx';
import type { GameScene } from '../core/GameScene.vx';
import { Rigidbody } from '../core/Rigidbody.vx';
import { BlockCrushHandler } from '../scripts/BlockCrushHandler.vx';
import { BlockCrusher } from '../scripts/BlockCrusher.vx';

export class BlockEnemy extends GameObject {
  readonly rigidbody: Rigidbody;
  readonly crusher: BlockCrusher;

  constructor(scene: GameScene, x: number, y: number) {
    super(scene, 'Block Enemy', makeBlockEnemy());
    this.rigidbody = addComponent(new Rigidbody({
      type: b2BodyType.b2_kinematicBody,
      position: { x, y },
      fixedRotation: true,
      allowSleep: false,
    }));
    rigidbody.addBoxCollider({
      halfWidth: 0.48,
      halfHeight: 0.48,
      kind: 'solid',
      friction: 0.8,
    });
    this.crusher = addComponent(new BlockCrusher(y));
    addComponent(new BlockCrushHandler());
  }
}
