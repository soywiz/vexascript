import { b2BodyType } from '@box2d/core';
import { makeQuestionBlock } from '../art.vx';
import { GameObject } from '../core/GameObject.vx';
import type { GameScene } from '../core/GameScene.vx';
import { Rigidbody } from '../core/Rigidbody.vx';
import { QuestionBlockHandler } from '../scripts/QuestionBlockHandler.vx';

export class QuestionBlock extends GameObject {
  readonly rigidbody: Rigidbody;
  readonly handler: QuestionBlockHandler;

  constructor(scene: GameScene, x: number, y: number) {
    super(scene, 'Question Block', makeQuestionBlock());
    this.rigidbody = addComponent(new Rigidbody({ type: b2BodyType.b2_staticBody, position: { x, y } }));
    rigidbody.addBoxCollider({ halfWidth: 0.43, halfHeight: 0.43, kind: 'question', friction: 0.2 });
    this.handler = addComponent(new QuestionBlockHandler(y));
  }
}
