import { makeCoin } from '../art.vx';
import { Component } from '../core/Component.vx';
import { GameObject } from '../core/GameObject.vx';
import type { GameScene } from '../core/GameScene.vx';
import { PIXELS_PER_METER } from '../core/constants.vx';

export class CoinBurst extends GameObject {
  constructor(scene: GameScene, x: number, y: number) {
    super(scene, 'Coin Burst', makeCoin());
    view.position.set(x * PIXELS_PER_METER, y * PIXELS_PER_METER);
    addComponent(CoinBurstAnimation());
  }
}

class CoinBurstAnimation extends Component {
  private velocityY = -265;
  private age = 0;

  update(delta: number): void {
    age += delta;
    velocityY += 650 * delta;
    gameObject.view.y += velocityY * delta;
    gameObject.view.rotation += delta * 7;
    gameObject.view.alpha = Math.max(0, 1 - Math.max(0, age - 0.55) / 0.25);
    if (age > 0.8) gameObject.destroy();
  }
}
