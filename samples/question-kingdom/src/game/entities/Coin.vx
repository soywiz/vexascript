import { b2BodyType } from '@box2d/core';
import { makeCoin } from '../art.vx';
import { GameObject } from '../core/GameObject.vx';
import type { GameScene } from '../core/GameScene.vx';
import { Rigidbody } from '../core/Rigidbody.vx';
import { CoinCollectHandler } from '../scripts/CoinCollectHandler.vx';

export class Coin extends GameObject {
  readonly rigidbody: Rigidbody;

  constructor(scene: GameScene, x: number, y: number) {
    super(scene, 'Coin', makeCoin());
    this.rigidbody = addComponent(new Rigidbody({ type: b2BodyType.b2_staticBody, position: { x, y } }));
    rigidbody.addBoxCollider({ halfWidth: 0.25, halfHeight: 0.32, kind: 'coin', isSensor: true });
    addComponent(new CoinCollectHandler(y, x * 0.73));
  }
}
