import { standardApiCheck } from "./checks.vx"

export async fun runPromiseSmoke(): Promise<void> {
  standardApiCheck(await Promise.resolve(3) === 3, "Promise.resolve")
  standardApiCheck(await Promise.reject("rejected").catch((reason: any) => reason) === "rejected", "Promise.reject")
  standardApiCheck(await Promise.resolve(3).then((value) => value + 1) === 4, "Promise.then")
  standardApiCheck(await Promise.reject("caught").catch((reason: any) => reason) === "caught", "Promise.catch")
  var finalized = false
  await Promise.resolve(1).finally(() => finalized = true)
  standardApiCheck(finalized, "Promise.finally")
  standardApiCheck((await Promise.all([Promise.resolve(1), Promise.resolve(2)])).join(",") === "1,2", "Promise.all")
  standardApiCheck((await Promise.allSettled([Promise.resolve(1)])).length === 1, "Promise.allSettled")
  standardApiCheck(await Promise.any([Promise.reject("ignored"), Promise.resolve(4)]) === 4, "Promise.any")
  standardApiCheck(await Promise.race([Promise.resolve(5), Promise.resolve(6)]) === 5, "Promise.race")
  val resolvers = Promise.withResolvers<number>()
  resolvers.resolve(6)
  standardApiCheck(await resolvers.promise === 6, "Promise.withResolvers")
  if (vexaRuntime() === "native") standardApiCheck(await Promise.try(() => 5) === 5, "Promise.try")
}
