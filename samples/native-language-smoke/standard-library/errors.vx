import { standardApiCheck } from "./checks.vx"

/** Exercises error identity, options, stack text, and every standard error constructor. */
export fun runErrorSmoke(): void {
  val error = Error("broken", { cause: "root" })
  standardApiCheck(error.message === "broken", "Error.message")
  standardApiCheck(error.name === "Error", "Error.name")
  standardApiCheck(error.stack!.includes("Error: broken"), "Error.stack")
  standardApiCheck(error.cause === "root", "Error.cause")

  standardApiCheck(EvalError("eval").name === "EvalError", "EvalError.name")
  standardApiCheck(RangeError("range").name === "RangeError", "RangeError.name")
  standardApiCheck(ReferenceError("reference").name === "ReferenceError", "ReferenceError.name")
  standardApiCheck(SyntaxError("syntax").name === "SyntaxError", "SyntaxError.name")
  standardApiCheck(TypeError("type").name === "TypeError", "TypeError.name")
  standardApiCheck(URIError("uri").name === "URIError", "URIError.name")

  val aggregate = AggregateError(["first", 2], "many", { cause: "batch" })
  standardApiCheck(aggregate.errors.length === 2, "AggregateError.errors")
  standardApiCheck(
    aggregate.name === "AggregateError" && aggregate.message === "many" && aggregate.cause === "batch",
    "AggregateError.name",
  )
}
