import { standardApiCheck } from "./checks.vx"

export fun runDateSmoke(): void {
  val date = new Date(0)
  standardApiCheck(date.getTime() === 0, "Date.getTime")
  standardApiCheck(date.valueOf() === 0, "Date.valueOf")
  standardApiCheck(date.getUTCFullYear() === 1970, "Date.getUTCFullYear")
  standardApiCheck(date.getUTCMonth() === 0, "Date.getUTCMonth")
  standardApiCheck(date.getUTCDate() === 1, "Date.getUTCDate")
  standardApiCheck(date.getUTCDay() === 4, "Date.getUTCDay")
  standardApiCheck(date.getUTCHours() === 0, "Date.getUTCHours")
  standardApiCheck(date.getUTCMinutes() === 0, "Date.getUTCMinutes")
  standardApiCheck(date.getUTCSeconds() === 0, "Date.getUTCSeconds")
  standardApiCheck(date.getUTCMilliseconds() === 0, "Date.getUTCMilliseconds")
  standardApiCheck(date.toISOString() === "1970-01-01T00:00:00.000Z", "Date.toISOString")
  standardApiCheck(date.toString().length > 0, "Date.toString")
  standardApiCheck(date.toJSON() === "1970-01-01T00:00:00.000Z", "Date.toJSON")
  standardApiCheck(Date.parse("1970-01-01") === 0, "Date.parse")
  standardApiCheck(Date.now() > 0, "Date.now")
  standardApiCheck(Date.UTC(2020, 0, 2, 3, 4, 5, 6) === 1577934245006, "Date.UTC")

  val local = new Date(2020, 0, 2, 3, 4, 5, 6)
  standardApiCheck(local.getFullYear() === 2020, "Date.getFullYear")
  standardApiCheck(local.getMonth() === 0, "Date.getMonth")
  standardApiCheck(local.getDate() === 2, "Date.getDate")
  standardApiCheck(local.getDay() >= 0 && local.getDay() <= 6, "Date.getDay")
  standardApiCheck(local.getHours() === 3, "Date.getHours")
  standardApiCheck(local.getMinutes() === 4, "Date.getMinutes")
  standardApiCheck(local.getSeconds() === 5, "Date.getSeconds")
  standardApiCheck(local.getMilliseconds() === 6, "Date.getMilliseconds")
  standardApiCheck(isFinite(local.getTimezoneOffset()), "Date.getTimezoneOffset")
  standardApiCheck(local.toDateString().length > 0, "Date.toDateString")
  standardApiCheck(local.toTimeString().length > 0, "Date.toTimeString")
  standardApiCheck(local.toUTCString().includes("GMT"), "Date.toUTCString")
  standardApiCheck(local.toLocaleString().length > 0, "Date.toLocaleString")
  standardApiCheck(local.toLocaleDateString().length > 0, "Date.toLocaleDateString")
  standardApiCheck(local.toLocaleTimeString().length > 0, "Date.toLocaleTimeString")

  val changed = new Date(Date.UTC(2020, 0, 2, 3, 4, 5, 6))
  changed.setTime(Date.UTC(2021, 0, 2))
  standardApiCheck(changed.getUTCFullYear() === 2021, "Date.setTime")
  changed.setUTCMilliseconds(7)
  standardApiCheck(changed.getUTCMilliseconds() === 7, "Date.setUTCMilliseconds")
  changed.setUTCSeconds(8, 9)
  standardApiCheck(changed.getUTCSeconds() === 8 && changed.getUTCMilliseconds() === 9, "Date.setUTCSeconds")
  changed.setUTCMinutes(10, 11, 12)
  standardApiCheck(changed.getUTCMinutes() === 10 && changed.getUTCSeconds() === 11, "Date.setUTCMinutes")
  changed.setUTCHours(13, 14, 15, 16)
  standardApiCheck(changed.getUTCHours() === 13 && changed.getUTCMinutes() === 14, "Date.setUTCHours")
  changed.setUTCDate(17)
  standardApiCheck(changed.getUTCDate() === 17, "Date.setUTCDate")
  changed.setUTCMonth(5, 18)
  standardApiCheck(changed.getUTCMonth() === 5 && changed.getUTCDate() === 18, "Date.setUTCMonth")
  changed.setUTCFullYear(2022, 6, 19)
  standardApiCheck(changed.getUTCFullYear() === 2022 && changed.getUTCMonth() === 6, "Date.setUTCFullYear")

  changed.setMilliseconds(20)
  standardApiCheck(changed.getMilliseconds() === 20, "Date.setMilliseconds")
  changed.setSeconds(21, 22)
  standardApiCheck(changed.getSeconds() === 21 && changed.getMilliseconds() === 22, "Date.setSeconds")
  changed.setMinutes(23, 24, 25)
  standardApiCheck(changed.getMinutes() === 23 && changed.getSeconds() === 24, "Date.setMinutes")
  changed.setHours(10, 26, 27, 28)
  standardApiCheck(changed.getHours() === 10 && changed.getMinutes() === 26, "Date.setHours")
  changed.setDate(12)
  standardApiCheck(changed.getDate() === 12, "Date.setDate")
  changed.setMonth(8, 13)
  standardApiCheck(changed.getMonth() === 8 && changed.getDate() === 13, "Date.setMonth")
  changed.setFullYear(2023, 9, 14)
  standardApiCheck(changed.getFullYear() === 2023 && changed.getMonth() === 9, "Date.setFullYear")
}
