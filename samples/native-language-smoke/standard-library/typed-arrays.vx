fun runBigInt64ArraySmoke(): void {
  val values = BigInt64Array.of(1n, 2n, 3n)
  standardApiCheck(BigInt64Array.BYTES_PER_ELEMENT === 8 && values.BYTES_PER_ELEMENT === 8, "BigInt64Array.BYTES_PER_ELEMENT")
  standardApiCheck(values.at(-1) === 3n, "BigInt64Array.at")
  standardApiCheck(values.buffer.byteLength === 24, "BigInt64Array.buffer")
  standardApiCheck(values.byteLength === 24, "BigInt64Array.byteLength")
  standardApiCheck(values.byteOffset === 0, "BigInt64Array.byteOffset")
  standardApiCheck(BigInt64Array.of(1n, 2n, 3n).copyWithin(0, 1).join(",") === "2,3,3", "BigInt64Array.copyWithin")
  standardApiCheck([...values.entries()].length === 3, "BigInt64Array.entries")
  standardApiCheck(values.every((value) => value > 0n), "BigInt64Array.every")
  standardApiCheck(BigInt64Array.of(1n, 2n, 3n).fill(4n, 1).join(",") === "1,4,4", "BigInt64Array.fill")
  standardApiCheck(values.filter((value) => value > 1n).join(",") === "2,3", "BigInt64Array.filter")
  standardApiCheck(values.find((value) => value > 1n) === 2n, "BigInt64Array.find")
  standardApiCheck(values.findIndex((value) => value > 1n) === 1, "BigInt64Array.findIndex")
  standardApiCheck(values.findLast((value) => value < 3n) === 2n, "BigInt64Array.findLast")
  standardApiCheck(values.findLastIndex((value) => value < 3n) === 1, "BigInt64Array.findLastIndex")
  var total = 0n
  values.forEach((value) => total += value)
  standardApiCheck(total === 6n, "BigInt64Array.forEach")
  standardApiCheck(BigInt64Array.from([1n, 2n], (value: bigint) => value + 1n).join(",") === "2,3", "BigInt64Array.from")
  standardApiCheck(values.includes(2n) && !values.includes(2n, 2), "BigInt64Array.includes")
  standardApiCheck(values.indexOf(2n) === 1 && values.indexOf(2n, 2) === -1, "BigInt64Array.indexOf")
  standardApiCheck(values.join("-") === "1-2-3", "BigInt64Array.join")
  standardApiCheck([...values.keys()].join(",") === "0,1,2", "BigInt64Array.keys")
  standardApiCheck(BigInt64Array.of(1n, 2n, 1n).lastIndexOf(1n) === 2, "BigInt64Array.lastIndexOf")
  standardApiCheck(values.length === 3, "BigInt64Array.length")
  standardApiCheck(values.map((value) => value * 2n).join(",") === "2,4,6", "BigInt64Array.map")
  standardApiCheck(values[0] === 1n, "BigInt64Array.of")
  standardApiCheck(values.reduce((sum, value) => sum + value, 0n) === 6n && values.reduce((sum, value) => sum + value) === 6n, "BigInt64Array.reduce")
  standardApiCheck(values.reduceRight((sum, value) => sum * 10n + value, 0n) === 321n, "BigInt64Array.reduceRight")
  standardApiCheck(BigInt64Array.of(1n, 2n, 3n).reverse().join(",") === "3,2,1", "BigInt64Array.reverse")
  val assigned = new BigInt64Array(4)
  assigned.set([8n, 9n], 1)
  standardApiCheck(assigned.join(",") === "0,8,9,0", "BigInt64Array.set")
  standardApiCheck(values.slice(1).join(",") === "2,3", "BigInt64Array.slice")
  standardApiCheck(values.some((value) => value === 2n), "BigInt64Array.some")
  standardApiCheck(BigInt64Array.of(3n, 1n, 2n).sort().join(",") === "1,2,3", "BigInt64Array.sort")
  val backing = new ArrayBuffer(64)
  val view = new BigInt64Array(backing, 16, 3)
  view[0] = 7n
  val child = view.subarray(1)
  child[0] = 8n
  standardApiCheck(view[1] === 8n && view.byteOffset === 16, "BigInt64Array.subarray")
  standardApiCheck(values.toLocaleString() === "1,2,3", "BigInt64Array.toLocaleString")
  standardApiCheck(values.toReversed().join(",") === "3,2,1", "BigInt64Array.toReversed")
  standardApiCheck(values.toSorted((left, right) => Number(right - left)).join(",") === "3,2,1", "BigInt64Array.toSorted")
  standardApiCheck(values.toString() === "1,2,3", "BigInt64Array.toString")
  standardApiCheck(values.valueOf() === values, "BigInt64Array.valueOf")
  standardApiCheck([...values.values()].join(",") === "1,2,3", "BigInt64Array.values")
  standardApiCheck(values.with(1, 4n).join(",") === "1,4,3", "BigInt64Array.with")
  val converted = BigInt64Array.of(18446744073709551615n)
  standardApiCheck(converted[0] === -1n, "typed BigInt64Array modulo conversion")
  standardApiCheck(ArrayBuffer.isView(view) === true, "typed BigInt64Array ArrayBuffer.isView")
}

