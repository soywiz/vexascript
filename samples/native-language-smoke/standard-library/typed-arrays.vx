import { standardApiCheck } from "./checks.vx"

fun runInt8ArraySmoke(): void {
  val values = Int8Array.of(1, 2, 3)
  standardApiCheck(Int8Array.BYTES_PER_ELEMENT === 1 && values.BYTES_PER_ELEMENT === 1, "Int8Array.BYTES_PER_ELEMENT")
  standardApiCheck(values.at(-1) === 3, "Int8Array.at")
  standardApiCheck(values.buffer.byteLength === 3, "Int8Array.buffer")
  standardApiCheck(values.byteLength === 3, "Int8Array.byteLength")
  standardApiCheck(values.byteOffset === 0, "Int8Array.byteOffset")
  standardApiCheck(Int8Array.of(1, 2, 3).copyWithin(0, 1).join(",") === "2,3,3", "Int8Array.copyWithin")
  standardApiCheck([...values.entries()].length === 3, "Int8Array.entries")
  standardApiCheck(values.every((value) => value > 0), "Int8Array.every")
  standardApiCheck(Int8Array.of(1, 2, 3).fill(4, 1).join(",") === "1,4,4", "Int8Array.fill")
  standardApiCheck(values.filter((value) => value > 1).join(",") === "2,3", "Int8Array.filter")
  standardApiCheck(values.find((value) => value > 1) === 2, "Int8Array.find")
  standardApiCheck(values.findIndex((value) => value > 1) === 1, "Int8Array.findIndex")
  standardApiCheck(values.findLast((value) => value < 3) === 2, "Int8Array.findLast")
  standardApiCheck(values.findLastIndex((value) => value < 3) === 1, "Int8Array.findLastIndex")
  var total: number = 0
  values.forEach((value) => total += value)
  standardApiCheck(total === 6, "Int8Array.forEach")
  standardApiCheck(Int8Array.from([1, 2], (value) => value + 1).join(",") === "2,3", "Int8Array.from")
  standardApiCheck(values.includes(2) && !values.includes(2, 2), "Int8Array.includes")
  standardApiCheck(values.indexOf(2) === 1 && values.indexOf(2, 2) === -1, "Int8Array.indexOf")
  standardApiCheck(values.join("-") === "1-2-3", "Int8Array.join")
  standardApiCheck([...values.keys()].join(",") === "0,1,2", "Int8Array.keys")
  standardApiCheck(Int8Array.of(1, 2, 1).lastIndexOf(1) === 2, "Int8Array.lastIndexOf")
  standardApiCheck(values.length === 3, "Int8Array.length")
  standardApiCheck(values.map((value) => value * 2).join(",") === "2,4,6", "Int8Array.map")
  standardApiCheck(values[0] === 1, "Int8Array.of")
  standardApiCheck(values.reduce((sum, value) => sum + value, 0) === 6 && values.reduce((sum, value) => sum + value) === 6, "Int8Array.reduce")
  standardApiCheck(values.reduceRight((sum, value) => sum * 10 + value, 0) === 321, "Int8Array.reduceRight")
  standardApiCheck(Int8Array.of(1, 2, 3).reverse().join(",") === "3,2,1", "Int8Array.reverse")
  val assigned = new Int8Array(4)
  assigned.set([8, 9], 1)
  standardApiCheck(assigned.join(",") === "0,8,9,0", "Int8Array.set")
  standardApiCheck(values.slice(1).join(",") === "2,3", "Int8Array.slice")
  standardApiCheck(values.some((value) => value === 2), "Int8Array.some")
  standardApiCheck(Int8Array.of(3, 1, 2).sort().join(",") === "1,2,3", "Int8Array.sort")
  val backing = new ArrayBuffer(8)
  val view = new Int8Array(backing, 2, 3)
  view[0] = 7
  val child = view.subarray(1)
  child[0] = 8
  standardApiCheck(view[1] === 8 && view.byteOffset === 2, "Int8Array.subarray")
  standardApiCheck(values.toLocaleString() === "1,2,3", "Int8Array.toLocaleString")
  standardApiCheck(values.toReversed().join(",") === "3,2,1", "Int8Array.toReversed")
  standardApiCheck(values.toSorted((left, right) => right - left).join(",") === "3,2,1", "Int8Array.toSorted")
  standardApiCheck(values.toString() === "1,2,3", "Int8Array.toString")
  standardApiCheck(values.valueOf() === values, "Int8Array.valueOf")
  standardApiCheck([...values.values()].join(",") === "1,2,3", "Int8Array.values")
  standardApiCheck(values.with(1, 4).join(",") === "1,4,3", "Int8Array.with")
  val converted = new Int8Array([130, -129])
  standardApiCheck(converted[0] === -126 && converted[1] === 127, "typed Int8Array modulo conversion")
  standardApiCheck(ArrayBuffer.isView(view) === true, "typed Int8Array ArrayBuffer.isView")
}

fun runUint8ArraySmoke(): void {
  val values = Uint8Array.of(1, 2, 3)
  standardApiCheck(Uint8Array.BYTES_PER_ELEMENT === 1 && values.BYTES_PER_ELEMENT === 1, "Uint8Array.BYTES_PER_ELEMENT")
  standardApiCheck(values.at(-1) === 3, "Uint8Array.at")
  standardApiCheck(values.buffer.byteLength === 3, "Uint8Array.buffer")
  standardApiCheck(values.byteLength === 3, "Uint8Array.byteLength")
  standardApiCheck(values.byteOffset === 0, "Uint8Array.byteOffset")
  standardApiCheck(Uint8Array.of(1, 2, 3).copyWithin(0, 1).join(",") === "2,3,3", "Uint8Array.copyWithin")
  standardApiCheck([...values.entries()].length === 3, "Uint8Array.entries")
  standardApiCheck(values.every((value) => value > 0), "Uint8Array.every")
  standardApiCheck(Uint8Array.of(1, 2, 3).fill(4, 1).join(",") === "1,4,4", "Uint8Array.fill")
  standardApiCheck(values.filter((value) => value > 1).join(",") === "2,3", "Uint8Array.filter")
  standardApiCheck(values.find((value) => value > 1) === 2, "Uint8Array.find")
  standardApiCheck(values.findIndex((value) => value > 1) === 1, "Uint8Array.findIndex")
  standardApiCheck(values.findLast((value) => value < 3) === 2, "Uint8Array.findLast")
  standardApiCheck(values.findLastIndex((value) => value < 3) === 1, "Uint8Array.findLastIndex")
  var total: number = 0
  values.forEach((value) => total += value)
  standardApiCheck(total === 6, "Uint8Array.forEach")
  standardApiCheck(Uint8Array.from([1, 2], (value) => value + 1).join(",") === "2,3", "Uint8Array.from")
  standardApiCheck(values.includes(2) && !values.includes(2, 2), "Uint8Array.includes")
  standardApiCheck(values.indexOf(2) === 1 && values.indexOf(2, 2) === -1, "Uint8Array.indexOf")
  standardApiCheck(values.join("-") === "1-2-3", "Uint8Array.join")
  standardApiCheck([...values.keys()].join(",") === "0,1,2", "Uint8Array.keys")
  standardApiCheck(Uint8Array.of(1, 2, 1).lastIndexOf(1) === 2, "Uint8Array.lastIndexOf")
  standardApiCheck(values.length === 3, "Uint8Array.length")
  standardApiCheck(values.map((value) => value * 2).join(",") === "2,4,6", "Uint8Array.map")
  standardApiCheck(values[0] === 1, "Uint8Array.of")
  standardApiCheck(values.reduce((sum, value) => sum + value, 0) === 6 && values.reduce((sum, value) => sum + value) === 6, "Uint8Array.reduce")
  standardApiCheck(values.reduceRight((sum, value) => sum * 10 + value, 0) === 321, "Uint8Array.reduceRight")
  standardApiCheck(Uint8Array.of(1, 2, 3).reverse().join(",") === "3,2,1", "Uint8Array.reverse")
  val assigned = new Uint8Array(4)
  assigned.set([8, 9], 1)
  standardApiCheck(assigned.join(",") === "0,8,9,0", "Uint8Array.set")
  standardApiCheck(values.slice(1).join(",") === "2,3", "Uint8Array.slice")
  standardApiCheck(values.some((value) => value === 2), "Uint8Array.some")
  standardApiCheck(Uint8Array.of(3, 1, 2).sort().join(",") === "1,2,3", "Uint8Array.sort")
  val backing = new ArrayBuffer(8)
  val view = new Uint8Array(backing, 2, 3)
  view[0] = 7
  val child = view.subarray(1)
  child[0] = 8
  standardApiCheck(view[1] === 8 && view.byteOffset === 2, "Uint8Array.subarray")
  standardApiCheck(values.toLocaleString() === "1,2,3", "Uint8Array.toLocaleString")
  standardApiCheck(values.toReversed().join(",") === "3,2,1", "Uint8Array.toReversed")
  standardApiCheck(values.toSorted((left, right) => right - left).join(",") === "3,2,1", "Uint8Array.toSorted")
  standardApiCheck(values.toString() === "1,2,3", "Uint8Array.toString")
  standardApiCheck(values.valueOf() === values, "Uint8Array.valueOf")
  standardApiCheck([...values.values()].join(",") === "1,2,3", "Uint8Array.values")
  standardApiCheck(values.with(1, 4).join(",") === "1,4,3", "Uint8Array.with")
  val converted = new Uint8Array([-1, 257])
  standardApiCheck(converted[0] === 255 && converted[1] === 1, "typed Uint8Array modulo conversion")
  standardApiCheck(ArrayBuffer.isView(view) === true, "typed Uint8Array ArrayBuffer.isView")
}

fun runUint8ClampedArraySmoke(): void {
  val values = Uint8ClampedArray.of(1, 2, 3)
  standardApiCheck(Uint8ClampedArray.BYTES_PER_ELEMENT === 1 && values.BYTES_PER_ELEMENT === 1, "Uint8ClampedArray.BYTES_PER_ELEMENT")
  standardApiCheck(values.at(-1) === 3, "Uint8ClampedArray.at")
  standardApiCheck(values.buffer.byteLength === 3, "Uint8ClampedArray.buffer")
  standardApiCheck(values.byteLength === 3, "Uint8ClampedArray.byteLength")
  standardApiCheck(values.byteOffset === 0, "Uint8ClampedArray.byteOffset")
  standardApiCheck(Uint8ClampedArray.of(1, 2, 3).copyWithin(0, 1).join(",") === "2,3,3", "Uint8ClampedArray.copyWithin")
  standardApiCheck([...values.entries()].length === 3, "Uint8ClampedArray.entries")
  standardApiCheck(values.every((value) => value > 0), "Uint8ClampedArray.every")
  standardApiCheck(Uint8ClampedArray.of(1, 2, 3).fill(4, 1).join(",") === "1,4,4", "Uint8ClampedArray.fill")
  standardApiCheck(values.filter((value) => value > 1).join(",") === "2,3", "Uint8ClampedArray.filter")
  standardApiCheck(values.find((value) => value > 1) === 2, "Uint8ClampedArray.find")
  standardApiCheck(values.findIndex((value) => value > 1) === 1, "Uint8ClampedArray.findIndex")
  standardApiCheck(values.findLast((value) => value < 3) === 2, "Uint8ClampedArray.findLast")
  standardApiCheck(values.findLastIndex((value) => value < 3) === 1, "Uint8ClampedArray.findLastIndex")
  var total: number = 0
  values.forEach((value) => total += value)
  standardApiCheck(total === 6, "Uint8ClampedArray.forEach")
  standardApiCheck(Uint8ClampedArray.from([1, 2], (value) => value + 1).join(",") === "2,3", "Uint8ClampedArray.from")
  standardApiCheck(values.includes(2) && !values.includes(2, 2), "Uint8ClampedArray.includes")
  standardApiCheck(values.indexOf(2) === 1 && values.indexOf(2, 2) === -1, "Uint8ClampedArray.indexOf")
  standardApiCheck(values.join("-") === "1-2-3", "Uint8ClampedArray.join")
  standardApiCheck([...values.keys()].join(",") === "0,1,2", "Uint8ClampedArray.keys")
  standardApiCheck(Uint8ClampedArray.of(1, 2, 1).lastIndexOf(1) === 2, "Uint8ClampedArray.lastIndexOf")
  standardApiCheck(values.length === 3, "Uint8ClampedArray.length")
  standardApiCheck(values.map((value) => value * 2).join(",") === "2,4,6", "Uint8ClampedArray.map")
  standardApiCheck(values[0] === 1, "Uint8ClampedArray.of")
  standardApiCheck(values.reduce((sum, value) => sum + value, 0) === 6 && values.reduce((sum, value) => sum + value) === 6, "Uint8ClampedArray.reduce")
  standardApiCheck(values.reduceRight((sum, value) => sum * 10 + value, 0) === 321, "Uint8ClampedArray.reduceRight")
  standardApiCheck(Uint8ClampedArray.of(1, 2, 3).reverse().join(",") === "3,2,1", "Uint8ClampedArray.reverse")
  val assigned = new Uint8ClampedArray(4)
  assigned.set([8, 9], 1)
  standardApiCheck(assigned.join(",") === "0,8,9,0", "Uint8ClampedArray.set")
  standardApiCheck(values.slice(1).join(",") === "2,3", "Uint8ClampedArray.slice")
  standardApiCheck(values.some((value) => value === 2), "Uint8ClampedArray.some")
  standardApiCheck(Uint8ClampedArray.of(3, 1, 2).sort().join(",") === "1,2,3", "Uint8ClampedArray.sort")
  val backing = new ArrayBuffer(8)
  val view = new Uint8ClampedArray(backing, 2, 3)
  view[0] = 7
  val child = view.subarray(1)
  child[0] = 8
  standardApiCheck(view[1] === 8 && view.byteOffset === 2, "Uint8ClampedArray.subarray")
  standardApiCheck(values.toLocaleString() === "1,2,3", "Uint8ClampedArray.toLocaleString")
  standardApiCheck(values.toReversed().join(",") === "3,2,1", "Uint8ClampedArray.toReversed")
  standardApiCheck(values.toSorted((left, right) => right - left).join(",") === "3,2,1", "Uint8ClampedArray.toSorted")
  standardApiCheck(values.toString() === "1,2,3", "Uint8ClampedArray.toString")
  standardApiCheck(values.valueOf() === values, "Uint8ClampedArray.valueOf")
  standardApiCheck([...values.values()].join(",") === "1,2,3", "Uint8ClampedArray.values")
  standardApiCheck(values.with(1, 4).join(",") === "1,4,3", "Uint8ClampedArray.with")
  val converted = new Uint8ClampedArray([-1, 1.5, 2.5, 300])
  standardApiCheck(converted.join(",") === "0,2,2,255", "typed Uint8ClampedArray clamp and ties-to-even conversion")
  standardApiCheck(ArrayBuffer.isView(view) === true, "typed Uint8ClampedArray ArrayBuffer.isView")
}

fun runInt16ArraySmoke(): void {
  val values = Int16Array.of(1, 2, 3)
  standardApiCheck(Int16Array.BYTES_PER_ELEMENT === 2 && values.BYTES_PER_ELEMENT === 2, "Int16Array.BYTES_PER_ELEMENT")
  standardApiCheck(values.at(-1) === 3, "Int16Array.at")
  standardApiCheck(values.buffer.byteLength === 6, "Int16Array.buffer")
  standardApiCheck(values.byteLength === 6, "Int16Array.byteLength")
  standardApiCheck(values.byteOffset === 0, "Int16Array.byteOffset")
  standardApiCheck(Int16Array.of(1, 2, 3).copyWithin(0, 1).join(",") === "2,3,3", "Int16Array.copyWithin")
  standardApiCheck([...values.entries()].length === 3, "Int16Array.entries")
  standardApiCheck(values.every((value) => value > 0), "Int16Array.every")
  standardApiCheck(Int16Array.of(1, 2, 3).fill(4, 1).join(",") === "1,4,4", "Int16Array.fill")
  standardApiCheck(values.filter((value) => value > 1).join(",") === "2,3", "Int16Array.filter")
  standardApiCheck(values.find((value) => value > 1) === 2, "Int16Array.find")
  standardApiCheck(values.findIndex((value) => value > 1) === 1, "Int16Array.findIndex")
  standardApiCheck(values.findLast((value) => value < 3) === 2, "Int16Array.findLast")
  standardApiCheck(values.findLastIndex((value) => value < 3) === 1, "Int16Array.findLastIndex")
  var total: number = 0
  values.forEach((value) => total += value)
  standardApiCheck(total === 6, "Int16Array.forEach")
  standardApiCheck(Int16Array.from([1, 2], (value) => value + 1).join(",") === "2,3", "Int16Array.from")
  standardApiCheck(values.includes(2) && !values.includes(2, 2), "Int16Array.includes")
  standardApiCheck(values.indexOf(2) === 1 && values.indexOf(2, 2) === -1, "Int16Array.indexOf")
  standardApiCheck(values.join("-") === "1-2-3", "Int16Array.join")
  standardApiCheck([...values.keys()].join(",") === "0,1,2", "Int16Array.keys")
  standardApiCheck(Int16Array.of(1, 2, 1).lastIndexOf(1) === 2, "Int16Array.lastIndexOf")
  standardApiCheck(values.length === 3, "Int16Array.length")
  standardApiCheck(values.map((value) => value * 2).join(",") === "2,4,6", "Int16Array.map")
  standardApiCheck(values[0] === 1, "Int16Array.of")
  standardApiCheck(values.reduce((sum, value) => sum + value, 0) === 6 && values.reduce((sum, value) => sum + value) === 6, "Int16Array.reduce")
  standardApiCheck(values.reduceRight((sum, value) => sum * 10 + value, 0) === 321, "Int16Array.reduceRight")
  standardApiCheck(Int16Array.of(1, 2, 3).reverse().join(",") === "3,2,1", "Int16Array.reverse")
  val assigned = new Int16Array(4)
  assigned.set([8, 9], 1)
  standardApiCheck(assigned.join(",") === "0,8,9,0", "Int16Array.set")
  standardApiCheck(values.slice(1).join(",") === "2,3", "Int16Array.slice")
  standardApiCheck(values.some((value) => value === 2), "Int16Array.some")
  standardApiCheck(Int16Array.of(3, 1, 2).sort().join(",") === "1,2,3", "Int16Array.sort")
  val backing = new ArrayBuffer(16)
  val view = new Int16Array(backing, 4, 3)
  view[0] = 7
  val child = view.subarray(1)
  child[0] = 8
  standardApiCheck(view[1] === 8 && view.byteOffset === 4, "Int16Array.subarray")
  standardApiCheck(values.toLocaleString() === "1,2,3", "Int16Array.toLocaleString")
  standardApiCheck(values.toReversed().join(",") === "3,2,1", "Int16Array.toReversed")
  standardApiCheck(values.toSorted((left, right) => right - left).join(",") === "3,2,1", "Int16Array.toSorted")
  standardApiCheck(values.toString() === "1,2,3", "Int16Array.toString")
  standardApiCheck(values.valueOf() === values, "Int16Array.valueOf")
  standardApiCheck([...values.values()].join(",") === "1,2,3", "Int16Array.values")
  standardApiCheck(values.with(1, 4).join(",") === "1,4,3", "Int16Array.with")
  val converted = new Int16Array([65535, 32768])
  standardApiCheck(converted[0] === -1 && converted[1] === -32768, "typed Int16Array modulo conversion")
  standardApiCheck(ArrayBuffer.isView(view) === true, "typed Int16Array ArrayBuffer.isView")
}

