  val converted = BigUint64Array.of(-1n)
  standardApiCheck(converted[0] === 18446744073709551615n, "typed BigUint64Array modulo conversion")
  standardApiCheck(ArrayBuffer.isView(view) === true, "typed BigUint64Array ArrayBuffer.isView")
}


export fun runTypedArraySmoke(): void {
  val byteBuffer = new ArrayBuffer(4)
  val bytes = new Uint8Array(byteBuffer)
  bytes[0] = -1
  standardApiCheck(bytes[0] === 255, "typed Uint8Array index conversion")
  standardApiCheck(bytes.buffer === byteBuffer, "Uint8Array.buffer")
  standardApiCheck(bytes.byteLength === 4, "Uint8Array.byteLength")
  standardApiCheck(bytes.byteOffset === 0, "Uint8Array.byteOffset")
  standardApiCheck(bytes.length === 4, "Uint8Array.length")
  standardApiCheck(ArrayBuffer.isView(bytes) === true, "ArrayBuffer.isView")
  val copiedBytes = new Uint8Array([1, 257, -1])
  standardApiCheck(copiedBytes[0] === 1 && copiedBytes[1] === 1 && copiedBytes[2] === 255, "Uint8Array iterable construction")

  val signedWords = new Int32Array(2)
  signedWords[0] = 4294967295
  standardApiCheck(signedWords[0] === -1, "typed Int32Array index conversion")
  standardApiCheck(signedWords.byteLength === 8, "Int32Array.byteLength")
  standardApiCheck(signedWords.byteOffset === 0, "Int32Array.byteOffset")
  standardApiCheck(signedWords.length === 2, "Int32Array.length")
  standardApiCheck(signedWords.buffer.byteLength === 8, "Int32Array.buffer")
  standardApiCheck(ArrayBuffer.isView(signedWords) === true, "typed Int32Array ArrayBuffer.isView")

  val words = new Uint32Array(2)
  words[0] = -1
  standardApiCheck(words[0] === 4294967295, "typed Uint32Array index conversion")
  standardApiCheck(words.byteLength === 8, "Uint32Array.byteLength")
  standardApiCheck(words.byteOffset === 0, "Uint32Array.byteOffset")
  standardApiCheck(words.length === 2, "Uint32Array.length")
  standardApiCheck(words.buffer.byteLength === 8, "Uint32Array.buffer")
  standardApiCheck(ArrayBuffer.isView(words) === true, "typed Uint32Array ArrayBuffer.isView")

  if (vexaRuntime() !== "native") return

  runInt8ArraySmoke()
  runUint8ArraySmoke()
  runUint8ClampedArraySmoke()
  runInt16ArraySmoke()
  runUint16ArraySmoke()
  runInt32ArraySmoke()
  runUint32ArraySmoke()
  runFloat32ArraySmoke()
  runFloat64ArraySmoke()
  runBigInt64ArraySmoke()
  runBigUint64ArraySmoke()

  val halves = Float16Array.of(1.5, 2.25, 3.75)
  standardApiCheck(Float16Array.BYTES_PER_ELEMENT === 2 && halves.BYTES_PER_ELEMENT === 2, "Float16Array.BYTES_PER_ELEMENT")
  standardApiCheck(halves.buffer.byteLength === 6, "Float16Array.buffer")
  standardApiCheck(halves.byteLength === 6, "Float16Array.byteLength")
  standardApiCheck(halves.byteOffset === 0, "Float16Array.byteOffset")
  standardApiCheck(halves.length === 3, "Float16Array.length")
  standardApiCheck(halves[1] === 2.25, "Float16Array.of")
  val mapped = Float16Array.from([1, 2], (value) => value + 0.5)
  standardApiCheck(mapped.join(",") === "1.5,2.5", "Float16Array.join")
  standardApiCheck(mapped.length === 2, "Float16Array.from")
  standardApiCheck(halves.at(-1) === 3.75, "Float16Array.at")
  standardApiCheck(Float16Array.of(1, 2, 3).copyWithin(0, 1).join(",") === "2,3,3", "Float16Array.copyWithin")
  standardApiCheck([...halves.entries()].length === 3, "Float16Array.entries")
  standardApiCheck(halves.every((value) => value > 0), "Float16Array.every")
  standardApiCheck(Float16Array.of(1, 2, 3).fill(4, 1).join(",") === "1,4,4", "Float16Array.fill")
  standardApiCheck(halves.filter((value) => value > 2).join(",") === "2.25,3.75", "Float16Array.filter")
  standardApiCheck(halves.find((value) => value > 2) === 2.25, "Float16Array.find")
  standardApiCheck(halves.findIndex((value) => value > 2) === 1, "Float16Array.findIndex")
  standardApiCheck(halves.findLast((value) => value < 3) === 2.25, "Float16Array.findLast")
  standardApiCheck(halves.findLastIndex((value) => value < 3) === 1, "Float16Array.findLastIndex")
  var total: number = 0
  halves.forEach((value) => total += value)
  standardApiCheck(total === 7.5, "Float16Array.forEach")
  standardApiCheck(halves.includes(2.25), "Float16Array.includes")
  standardApiCheck(halves.indexOf(2.25) === 1, "Float16Array.indexOf")
  standardApiCheck([...halves.keys()].join(",") === "0,1,2", "Float16Array.keys")
  standardApiCheck(Float16Array.of(1, 2, 1).lastIndexOf(1) === 2, "Float16Array.lastIndexOf")
  standardApiCheck(halves.map((value) => value * 2).join(",") === "3,4.5,7.5", "Float16Array.map")
  standardApiCheck(halves.reduce((sum, value) => sum + value, 0) === 7.5, "Float16Array.reduce")
  standardApiCheck(Float16Array.of(1, 2, 3).reduceRight((sum, value) => sum * 10 + value, 0) === 321, "Float16Array.reduceRight")
  standardApiCheck(Float16Array.of(1, 2, 3).reverse().join(",") === "3,2,1", "Float16Array.reverse")
  val setHalves = new Float16Array(4)
  setHalves.set([1.5, 2.5], 1)
  standardApiCheck(setHalves.join(",") === "0,1.5,2.5,0", "Float16Array.set")
  standardApiCheck(halves.slice(1).join(",") === "2.25,3.75", "Float16Array.slice")
  standardApiCheck(halves.some((value) => value === 2.25), "Float16Array.some")
  standardApiCheck(Float16Array.of(3, 1, 2).sort().join(",") === "1,2,3", "Float16Array.sort")
  val halfViewSource = Float16Array.of(1.5, 2.25, 3.75)
  val halfView = halfViewSource.subarray(1)
  halfView[0] = 4.5
  standardApiCheck(halfViewSource[1] === 4.5 && halfView.byteOffset === 2, "Float16Array.subarray")
  standardApiCheck(halves.toLocaleString().length > 0, "Float16Array.toLocaleString")
  standardApiCheck(halves.toReversed().join(",") === "3.75,2.25,1.5", "Float16Array.toReversed")
  standardApiCheck(halves.toSorted((left, right) => right - left).join(",") === "3.75,2.25,1.5", "Float16Array.toSorted")
  standardApiCheck(halves.toString().length > 0, "Float16Array.toString")
  standardApiCheck(halves.valueOf() === halves, "Float16Array.valueOf")
  standardApiCheck([...halves.values()].join(",") === "1.5,2.25,3.75", "Float16Array.values")
  standardApiCheck(halves.with(1, 4.5).join(",") === "1.5,4.5,3.75", "Float16Array.with")
}
