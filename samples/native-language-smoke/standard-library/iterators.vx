import { standardApiCheck } from "./checks.vx"

export fun runIteratorSmoke(): void {
  val values = [1, 2, 3, 4]
  standardApiCheck(Iterator.from(values).map((value) => value * 2).toArray().join(",") === "2,4,6,8", "Iterator.map")
  standardApiCheck(Iterator.from(values).filter((value) => value % 2 === 0).toArray().join(",") === "2,4", "Iterator.filter")
  standardApiCheck(Iterator.from(values).take(2).toArray().join(",") === "1,2", "Iterator.take")
  standardApiCheck(Iterator.from(values).drop(2).toArray().join(",") === "3,4", "Iterator.drop")
  standardApiCheck(Iterator.from(values).flatMap((value) => [value, value]).toArray().length === 8, "Iterator.flatMap")
  standardApiCheck(Iterator.from(values).reduce((total, value) => total + value, 0) === 10, "Iterator.reduce")
  standardApiCheck(Iterator.from(values).toArray().length === 4, "Iterator.toArray")
  var total = 0
  Iterator.from(values).forEach((value) => total += value)
  standardApiCheck(total === 10, "Iterator.forEach")
  standardApiCheck(Iterator.from(values).some((value) => value === 3), "Iterator.some")
  standardApiCheck(Iterator.from(values).every((value) => value > 0), "Iterator.every")
  standardApiCheck(Iterator.from(values).find((value) => value === 3) === 3, "Iterator.find")
  standardApiCheck(Iterator.from(values).toArray().length === 4, "Iterator.from")
}
