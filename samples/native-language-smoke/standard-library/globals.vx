import { standardApiCheck } from "./checks.vx"

/** Locks every supported top-level ECMAScript constructor, namespace, or singleton. */
export async fun runGlobalValueSmoke(): Promise<void> {
  standardApiCheck(performance.now() >= 0, "global.performance")
  standardApiCheck(Object.keys({ value: 1 }).length === 1, "global.Object")
  standardApiCheck(String(12) === "12", "global.String")
  standardApiCheck(Boolean(1), "global.Boolean")
  standardApiCheck(Number("12") === 12, "global.Number")
  standardApiCheck(Math.abs(-1) === 1, "global.Math")
  standardApiCheck(new Date(0).getTime() === 0, "global.Date")
  standardApiCheck(new RegExp("a", "i").test("A"), "global.RegExp")
  standardApiCheck(Error("error").message === "error", "global.Error")
  standardApiCheck(EvalError("eval").message === "eval", "global.EvalError")
  standardApiCheck(RangeError("range").message === "range", "global.RangeError")
  standardApiCheck(ReferenceError("reference").message === "reference", "global.ReferenceError")
  standardApiCheck(SyntaxError("syntax").message === "syntax", "global.SyntaxError")
  standardApiCheck(TypeError("type").message === "type", "global.TypeError")
  standardApiCheck(URIError("uri").message === "uri", "global.URIError")
  standardApiCheck(AggregateError([], "aggregate").message === "aggregate", "global.AggregateError")
  standardApiCheck(JSON.stringify({ ready: true }) === "{\"ready\":true}", "global.JSON")
  standardApiCheck(Array.of(1).length === 1, "global.Array")
  standardApiCheck(new ArrayBuffer(1).byteLength === 1, "global.ArrayBuffer")
  standardApiCheck(new DataView(new ArrayBuffer(1)).byteLength === 1, "global.DataView")
  standardApiCheck(new Uint8Array(1).length === 1, "global.Uint8Array")
  standardApiCheck(new Int8Array(1).length === 1, "global.Int8Array")
  standardApiCheck(new Uint8ClampedArray(1).length === 1, "global.Uint8ClampedArray")
  standardApiCheck(new Int16Array(1).length === 1, "global.Int16Array")
  standardApiCheck(new Uint16Array(1).length === 1, "global.Uint16Array")
  standardApiCheck(new Int32Array(1).length === 1, "global.Int32Array")
  standardApiCheck(new Uint32Array(1).length === 1, "global.Uint32Array")
  standardApiCheck(new Float32Array(1).length === 1, "global.Float32Array")
  standardApiCheck(new Float64Array(1).length === 1, "global.Float64Array")
  standardApiCheck(new BigInt64Array(1).length === 1, "global.BigInt64Array")
  standardApiCheck(new BigUint64Array(1).length === 1, "global.BigUint64Array")
  standardApiCheck(new Map<string, number>().size === 0, "global.Map")
  val weakKey = { ready: true }
  standardApiCheck(new WeakMap<object, number>([[weakKey, 1]]).has(weakKey), "global.WeakMap")
  standardApiCheck(new Set<number>([1]).has(1), "global.Set")
  standardApiCheck(new WeakSet<object>([weakKey]).has(weakKey), "global.WeakSet")
  standardApiCheck(await Promise.resolve(1) === 1, "global.Promise")
  standardApiCheck(new SharedArrayBuffer(1).byteLength === 1, "global.SharedArrayBuffer")
  standardApiCheck(Atomics.isLockFree(4), "global.Atomics")
  standardApiCheck(BigInt("1") === 1n, "global.BigInt")
  if (vexaRuntime() === "native") {
    standardApiCheck(Float16Array.of(1).length === 1, "global.Float16Array")
  }
}
