import { standardApiCheck } from "./checks.vx"

export fun runArraySmoke(): void {
  val array = [1, 2, 3]
  standardApiCheck(array.length === 3, "Array.length")
  standardApiCheck(array.at(-1) === 3, "Array.at")
  standardApiCheck(array.concat(4).join(",") === "1,2,3,4", "Array.concat")
  standardApiCheck([1, 2, 3, 4].copyWithin(1, 2).join(",") === "1,3,4,4", "Array.copyWithin")
  standardApiCheck(array.every((value) => value > 0), "Array.every")
  var entryCount = 0
  for (val entry of array.entries()) entryCount += 1
  standardApiCheck(entryCount === 3, "Array.entries")
  standardApiCheck([1, 2, 3].fill(8, 1).join(",") === "1,8,8", "Array.fill")
  standardApiCheck(array.filter((value) => value % 2 === 1).join(",") === "1,3", "Array.filter")
  standardApiCheck(array.find((value) => value === 2) === 2, "Array.find")
  standardApiCheck(array.findIndex((value) => value === 2) === 1, "Array.findIndex")
  standardApiCheck([[1], [2, 3]].flat().join(",") === "1,2,3", "Array.flat")
  standardApiCheck(array.flatMap((value) => [value, value]).length === 6, "Array.flatMap")
  var total = 0
  array.forEach((value) => total += value)
  standardApiCheck(total === 6, "Array.forEach")
  standardApiCheck(array.includes(2), "Array.includes")
  standardApiCheck(array.indexOf(2) === 1, "Array.indexOf")
  standardApiCheck(array.join("|") === "1|2|3", "Array.join")
  standardApiCheck([...array.keys()].join(",") === "0,1,2", "Array.keys")
  standardApiCheck([1, 2, 1].lastIndexOf(1) === 2, "Array.lastIndexOf")
  standardApiCheck(array.map((value) => value * 2).join(",") === "2,4,6", "Array.map")
  val popped = [1, 2]
  standardApiCheck(popped.pop() === 2, "Array.pop")
  val pushed = [1]
  standardApiCheck(pushed.push(2) === 2, "Array.push")
  standardApiCheck(array.reduce((sum, value) => sum + value, 0) === 6, "Array.reduce")
  standardApiCheck(array.reduceRight((sum, value) => sum * 10 + value, 0) === 321, "Array.reduceRight")
  standardApiCheck([1, 2, 3].reverse().join(",") === "3,2,1", "Array.reverse")
  val shifted = [1, 2]
  standardApiCheck(shifted.shift() === 1, "Array.shift")
  standardApiCheck(array.slice(1).join(",") === "2,3", "Array.slice")
  standardApiCheck(array.some((value) => value === 2), "Array.some")
  standardApiCheck([3, 1, 2].sort().join(",") === "1,2,3", "Array.sort")
  val spliced = [1, 2, 3]
  standardApiCheck(spliced.splice(1, 1, 8).join(",") === "2" && spliced.join(",") === "1,8,3", "Array.splice")
  val text = array.toString()
  standardApiCheck(text === "1,2,3" || text === "[1, 2, 3]", "Array.toString")
  val localizedText = array.toLocaleString()
  standardApiCheck(localizedText === "1,2,3" || localizedText === "[1, 2, 3]", "Array.toLocaleString")
  val unshifted = [2, 3]
  standardApiCheck(unshifted.unshift(1) === 3 && unshifted[0] === 1, "Array.unshift")
  standardApiCheck(Array.isArray(array) === true, "Array.isArray")
  standardApiCheck(Array.from(array).join(",") === "1,2,3", "Array.from")
  standardApiCheck(Array.of(1, 2, 3).join(",") === "1,2,3", "Array.of")
  standardApiCheck([...array.values()].join(",") === "1,2,3", "Array.values")

  val modern = [1, 2, 3, 2]
  standardApiCheck(modern.findLast((value) => value === 2) === 2, "Array.findLast")
  standardApiCheck(modern.findLastIndex((value) => value === 2) === 3, "Array.findLastIndex")
  standardApiCheck(modern.toReversed().join(",") === "2,3,2,1", "Array.toReversed")
  standardApiCheck(modern.toSorted((left, right) => right - left).join(",") === "3,2,2,1", "Array.toSorted")
  standardApiCheck(modern.toSpliced(1, 2, 8, 9).join(",") === "1,8,9,2", "Array.toSpliced")
  standardApiCheck(modern.with(1, 7).join(",") === "1,7,3,2", "Array.with")
}
