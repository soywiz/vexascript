import { standardApiCheck } from "./checks.vx"

fun standardApiBytes(view: DataView, offset: int, expected: number[], name: string): void {
  var index = 0
  while (index < expected.length) {
    standardApiCheck(view.getUint8(offset + index) === expected[index], `${name}[${index}]`)
    index++
  }
}

export fun runBinaryDataSmoke(): void {
  val buffer = new ArrayBuffer(136)
  standardApiCheck(buffer.byteLength === 136, "ArrayBuffer.byteLength")
  standardApiCheck(buffer.maxByteLength === 136, "ArrayBuffer.maxByteLength")
  standardApiCheck(!buffer.resizable, "ArrayBuffer.resizable")
  standardApiCheck(!buffer.detached, "ArrayBuffer.detached")
  standardApiCheck(buffer.slice(4, 12).byteLength === 8, "ArrayBuffer.slice")
  val resizable = new ArrayBuffer(4, { maxByteLength: 8 })
  standardApiCheck(resizable.resizable && resizable.maxByteLength === 8, "binary resizable ArrayBuffer options")
  resizable.resize(6)
  standardApiCheck(resizable.byteLength === 6, "ArrayBuffer.resize")
  val transferSource = new ArrayBuffer(4)
  new Uint8Array(transferSource)[0] = 42
  val transferred = transferSource.transfer(6)
  standardApiCheck(transferSource.detached && transferred.byteLength === 6 && new Uint8Array(transferred)[0] === 42, "ArrayBuffer.transfer")
  val fixedSource = new ArrayBuffer(4, { maxByteLength: 8 })
  val fixed = fixedSource.transferToFixedLength(2)
  standardApiCheck(fixedSource.detached && !fixed.resizable && fixed.byteLength === 2, "ArrayBuffer.transferToFixedLength")
  val view = new DataView(buffer)
  standardApiCheck(view.buffer === buffer, "DataView.buffer")
  standardApiCheck(view.byteLength === 136, "DataView.byteLength")
  standardApiCheck(view.byteOffset === 0, "DataView.byteOffset")
  view.setInt8(0, 127)
  standardApiCheck(view.getInt8(0) === 127, "DataView.setInt8")
  standardApiCheck(view.getInt8(0) === 127, "DataView.getInt8")
  view.setUint8(1, 255)
  standardApiCheck(view.getUint8(1) === 255, "DataView.setUint8")
  standardApiCheck(view.getUint8(1) === 255, "DataView.getUint8")

  view.setInt16(2, 0x1234)
  standardApiBytes(view, 2, [0x12, 0x34], "DataView.setInt16 default layout")
  standardApiCheck(view.getInt16(2) === 0x1234, "DataView.setInt16")
  standardApiCheck(view.getInt16(2) === 0x1234, "DataView.getInt16")
  view.setInt16(4, 0x1234, false)
  standardApiBytes(view, 4, [0x12, 0x34], "DataView.setInt16 false layout")
  standardApiCheck(view.getInt16(4, false) === 0x1234, "DataView.getInt16 false")
  view.setInt16(6, 0x1234, true)
  standardApiBytes(view, 6, [0x34, 0x12], "DataView.setInt16 true layout")
  standardApiCheck(view.getInt16(6, true) === 0x1234, "DataView.getInt16 true")

  view.setUint16(8, 0xabcd)
  standardApiBytes(view, 8, [0xab, 0xcd], "DataView.setUint16 default layout")
  standardApiCheck(view.getUint16(8) === 0xabcd, "DataView.setUint16")
  standardApiCheck(view.getUint16(8) === 0xabcd, "DataView.getUint16")
  view.setUint16(10, 0xabcd, false)
  standardApiBytes(view, 10, [0xab, 0xcd], "DataView.setUint16 false layout")
  standardApiCheck(view.getUint16(10, false) === 0xabcd, "DataView.getUint16 false")
  view.setUint16(12, 0xabcd, true)
  standardApiBytes(view, 12, [0xcd, 0xab], "DataView.setUint16 true layout")
  standardApiCheck(view.getUint16(12, true) === 0xabcd, "DataView.getUint16 true")

  view.setInt32(16, 0x12345678)
  standardApiBytes(view, 16, [0x12, 0x34, 0x56, 0x78], "DataView.setInt32 default layout")
  standardApiCheck(view.getInt32(16) === 0x12345678, "DataView.setInt32")
  standardApiCheck(view.getInt32(16) === 0x12345678, "DataView.getInt32")
  view.setInt32(20, 0x12345678, false)
  standardApiBytes(view, 20, [0x12, 0x34, 0x56, 0x78], "DataView.setInt32 false layout")
  standardApiCheck(view.getInt32(20, false) === 0x12345678, "DataView.getInt32 false")
  view.setInt32(24, 0x12345678, true)
  standardApiBytes(view, 24, [0x78, 0x56, 0x34, 0x12], "DataView.setInt32 true layout")
  standardApiCheck(view.getInt32(24, true) === 0x12345678, "DataView.getInt32 true")

  view.setUint32(28, 0x89abcdef)
  standardApiBytes(view, 28, [0x89, 0xab, 0xcd, 0xef], "DataView.setUint32 default layout")
  standardApiCheck(view.getUint32(28) === 0x89abcdef, "DataView.setUint32")
  standardApiCheck(view.getUint32(28) === 0x89abcdef, "DataView.getUint32")
  view.setUint32(32, 0x89abcdef, false)
  standardApiBytes(view, 32, [0x89, 0xab, 0xcd, 0xef], "DataView.setUint32 false layout")
  standardApiCheck(view.getUint32(32, false) === 0x89abcdef, "DataView.getUint32 false")
  view.setUint32(36, 0x89abcdef, true)
  standardApiBytes(view, 36, [0xef, 0xcd, 0xab, 0x89], "DataView.setUint32 true layout")
  standardApiCheck(view.getUint32(36, true) === 0x89abcdef, "DataView.getUint32 true")

  view.setFloat32(40, 1.5)
  standardApiBytes(view, 40, [0x3f, 0xc0, 0x00, 0x00], "DataView.setFloat32 default layout")
  standardApiCheck(view.getFloat32(40) === 1.5, "DataView.setFloat32")
  standardApiCheck(view.getFloat32(40) === 1.5, "DataView.getFloat32")
  view.setFloat32(44, 1.5, false)
  standardApiBytes(view, 44, [0x3f, 0xc0, 0x00, 0x00], "DataView.setFloat32 false layout")
  standardApiCheck(view.getFloat32(44, false) === 1.5, "DataView.getFloat32 false")
  view.setFloat32(48, 1.5, true)
  standardApiBytes(view, 48, [0x00, 0x00, 0xc0, 0x3f], "DataView.setFloat32 true layout")
  standardApiCheck(view.getFloat32(48, true) === 1.5, "DataView.getFloat32 true")

  view.setFloat64(56, 1.5)
  standardApiBytes(view, 56, [0x3f, 0xf8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00], "DataView.setFloat64 default layout")
  standardApiCheck(view.getFloat64(56) === 1.5, "DataView.setFloat64")
  standardApiCheck(view.getFloat64(56) === 1.5, "DataView.getFloat64")
  view.setFloat64(64, 1.5, false)
  standardApiBytes(view, 64, [0x3f, 0xf8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00], "DataView.setFloat64 false layout")
  standardApiCheck(view.getFloat64(64, false) === 1.5, "DataView.getFloat64 false")
  view.setFloat64(72, 1.5, true)
  standardApiBytes(view, 72, [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xf8, 0x3f], "DataView.setFloat64 true layout")
  standardApiCheck(view.getFloat64(72, true) === 1.5, "DataView.getFloat64 true")

  view.setFloat16(80, 1.5)
  standardApiBytes(view, 80, [0x3e, 0x00], "DataView.setFloat16 default layout")
  standardApiCheck(view.getFloat16(80) === 1.5, "DataView.setFloat16")
  standardApiCheck(view.getFloat16(80) === 1.5, "DataView.getFloat16")
  view.setFloat16(82, 1.5, false)
  standardApiBytes(view, 82, [0x3e, 0x00], "DataView.setFloat16 false layout")
  standardApiCheck(view.getFloat16(82, false) === 1.5, "DataView.getFloat16 false")
  view.setFloat16(84, 1.5, true)
  standardApiBytes(view, 84, [0x00, 0x3e], "DataView.setFloat16 true layout")
  standardApiCheck(view.getFloat16(84, true) === 1.5, "DataView.getFloat16 true")

  view.setBigInt64(88, 0x0102030405060708n)
  standardApiBytes(view, 88, [1, 2, 3, 4, 5, 6, 7, 8], "DataView.setBigInt64 default layout")
  standardApiCheck(view.getBigInt64(88) === 0x0102030405060708n, "DataView.setBigInt64")
  standardApiCheck(view.getBigInt64(88) === 0x0102030405060708n, "DataView.getBigInt64")
  view.setBigInt64(96, 0x0102030405060708n, false)
  standardApiBytes(view, 96, [1, 2, 3, 4, 5, 6, 7, 8], "DataView.setBigInt64 false layout")
  standardApiCheck(view.getBigInt64(96, false) === 0x0102030405060708n, "DataView.getBigInt64 false")
  view.setBigInt64(104, 0x0102030405060708n, true)
  standardApiBytes(view, 104, [8, 7, 6, 5, 4, 3, 2, 1], "DataView.setBigInt64 true layout")
  standardApiCheck(view.getBigInt64(104, true) === 0x0102030405060708n, "DataView.getBigInt64 true")

  view.setBigUint64(112, 0x89abcdef01234567n)
  standardApiBytes(view, 112, [0x89, 0xab, 0xcd, 0xef, 1, 0x23, 0x45, 0x67], "DataView.setBigUint64 default layout")
  standardApiCheck(view.getBigUint64(112) === 0x89abcdef01234567n, "DataView.setBigUint64")
  standardApiCheck(view.getBigUint64(112) === 0x89abcdef01234567n, "DataView.getBigUint64")
  view.setBigUint64(120, 0x89abcdef01234567n, false)
  standardApiBytes(view, 120, [0x89, 0xab, 0xcd, 0xef, 1, 0x23, 0x45, 0x67], "DataView.setBigUint64 false layout")
  standardApiCheck(view.getBigUint64(120, false) === 0x89abcdef01234567n, "DataView.getBigUint64 false")
  view.setBigUint64(128, 0x89abcdef01234567n, true)
  standardApiBytes(view, 128, [0x67, 0x45, 0x23, 1, 0xef, 0xcd, 0xab, 0x89], "DataView.setBigUint64 true layout")
  standardApiCheck(view.getBigUint64(128, true) === 0x89abcdef01234567n, "DataView.getBigUint64 true")
}
