import { standardApiCheck } from "./checks.vx"

/** Exercises the compact English-only Intl implementation without external locale databases. */
export fun runIntlSmoke(): void {
  if (vexaRuntime() !== "native") return

  standardApiCheck(Intl.getCanonicalLocales(["en_us", "en-US"]).join(",") === "en-US", "Intl.getCanonicalLocales.result")
  standardApiCheck(Intl.supportedValuesOf("currency").includes("USD"), "Intl.supportedValuesOf.result")

  val collator = new Intl.Collator("en", { numeric: true, sensitivity: "base" })
  standardApiCheck(collator.compare("2", "10") < 0 && collator.compare("A", "a") === 0, "Intl.Collator.compare")
  standardApiCheck(collator.resolvedOptions().numeric, "Intl.Collator.resolvedOptions")
  standardApiCheck(Intl.Collator.supportedLocalesOf(["en", "en-US"]).length === 2, "Intl.Collator.supportedLocalesOf")

  val number = new Intl.NumberFormat("en", { style: "currency", currency: "USD" })
  standardApiCheck(number.format(12.5).includes("USD"), "Intl.NumberFormat.format")
  standardApiCheck(number.formatToParts(12).length > 0, "Intl.NumberFormat.formatToParts")
  standardApiCheck(number.formatRange(1, 2).includes("–"), "Intl.NumberFormat.formatRange")
  standardApiCheck(number.formatRangeToParts(1, 2).length === 3, "Intl.NumberFormat.formatRangeToParts")
  standardApiCheck(number.resolvedOptions().style === "currency", "Intl.NumberFormat.resolvedOptions")
  standardApiCheck(Intl.NumberFormat.supportedLocalesOf("en").length === 1, "Intl.NumberFormat.supportedLocalesOf")

  val dateTime = new Intl.DateTimeFormat("en", { timeZone: "UTC", year: "numeric", month: "2-digit", day: "2-digit" })
  standardApiCheck(dateTime.format(0) === "1970-01-01", "Intl.DateTimeFormat.format")
  standardApiCheck(dateTime.formatToParts(0).length > 0, "Intl.DateTimeFormat.formatToParts")
  standardApiCheck(dateTime.formatRange(0, 86400000).includes("–"), "Intl.DateTimeFormat.formatRange")
  standardApiCheck(dateTime.formatRangeToParts(0, 86400000).length === 3, "Intl.DateTimeFormat.formatRangeToParts")
  standardApiCheck(dateTime.resolvedOptions().timeZone === "UTC", "Intl.DateTimeFormat.resolvedOptions")
  standardApiCheck(Intl.DateTimeFormat.supportedLocalesOf("en").length === 1, "Intl.DateTimeFormat.supportedLocalesOf")

  val display = new Intl.DisplayNames("en", { type: "region" })
  standardApiCheck(display.of("US") === "United States", "Intl.DisplayNames.of")
  standardApiCheck(display.resolvedOptions().type === "region", "Intl.DisplayNames.resolvedOptions")
  standardApiCheck(Intl.DisplayNames.supportedLocalesOf("en").length === 1, "Intl.DisplayNames.supportedLocalesOf")

  val list = new Intl.ListFormat("en", { style: "long", type: "conjunction" })
  standardApiCheck(list.format(["red", "green", "blue"]) === "red, green, and blue", "Intl.ListFormat.format")
  standardApiCheck(list.formatToParts(["red", "blue"]).length === 2, "Intl.ListFormat.formatToParts")
  standardApiCheck(list.resolvedOptions().type === "conjunction", "Intl.ListFormat.resolvedOptions")
  standardApiCheck(Intl.ListFormat.supportedLocalesOf("en").length === 1, "Intl.ListFormat.supportedLocalesOf")

  val locale = new Intl.Locale("en-us", { calendar: "gregory", numeric: true })
  standardApiCheck(locale.baseName === "en-US", "Intl.Locale.baseName")
  standardApiCheck(locale.language === "en", "Intl.Locale.language")
  standardApiCheck(locale.region === "US", "Intl.Locale.region")
  standardApiCheck(locale.script === undefined, "Intl.Locale.script")
  standardApiCheck(locale.calendar === "gregory", "Intl.Locale.calendar")
  standardApiCheck(locale.caseFirst === undefined, "Intl.Locale.caseFirst")
  standardApiCheck(locale.collation === undefined, "Intl.Locale.collation")
  standardApiCheck(locale.hourCycle === undefined, "Intl.Locale.hourCycle")
  standardApiCheck(locale.numberingSystem === undefined, "Intl.Locale.numberingSystem")
  standardApiCheck(locale.numeric, "Intl.Locale.numeric")
  standardApiCheck(locale.maximize().toString() === "en-Latn-US", "Intl.Locale.maximize")
  standardApiCheck(locale.minimize().toString() === "en", "Intl.Locale.minimize")
  standardApiCheck(locale.toString() === "en-US", "Intl.Locale.toString")

  val plurals = new Intl.PluralRules("en", { type: "ordinal" })
  standardApiCheck(plurals.select(1) === "one" && plurals.select(2) === "two", "Intl.PluralRules.select")
  standardApiCheck(plurals.selectRange(1, 2) === "other", "Intl.PluralRules.selectRange")
  standardApiCheck(plurals.resolvedOptions().type === "ordinal", "Intl.PluralRules.resolvedOptions")
  standardApiCheck(Intl.PluralRules.supportedLocalesOf("en").length === 1, "Intl.PluralRules.supportedLocalesOf")

  val relative = new Intl.RelativeTimeFormat("en", { numeric: "auto", style: "long" })
  standardApiCheck(relative.format(-1, "day") === "yesterday", "Intl.RelativeTimeFormat.format")
  standardApiCheck(relative.formatToParts(2, "day").length === 2, "Intl.RelativeTimeFormat.formatToParts")
  standardApiCheck(relative.resolvedOptions().numeric === "auto", "Intl.RelativeTimeFormat.resolvedOptions")
  standardApiCheck(Intl.RelativeTimeFormat.supportedLocalesOf("en").length === 1, "Intl.RelativeTimeFormat.supportedLocalesOf")

  val segmenter = new Intl.Segmenter("en", { granularity: "word" })
  val segments = segmenter.segment("hello world")
  standardApiCheck(Array.from(segments).length === 3, "Intl.Segmenter.segment")
  standardApiCheck(segments.containing(7)?.segment === "world", "Intl.Segments.containing")
  standardApiCheck(segmenter.resolvedOptions().granularity === "word", "Intl.Segmenter.resolvedOptions")
  standardApiCheck(Intl.Segmenter.supportedLocalesOf("en").length === 1, "Intl.Segmenter.supportedLocalesOf")

  val duration = new Intl.DurationFormat("en", { style: "short" })
  standardApiCheck((duration.format({ hours: 1, minutes: 2 }) as string).length > 0, "Intl.DurationFormat.format")
  standardApiCheck((duration.formatToParts({ seconds: 3 }) as unknown[]).length > 0, "Intl.DurationFormat.formatToParts")
  standardApiCheck((duration.resolvedOptions() as { style: string }).style === "short", "Intl.DurationFormat.resolvedOptions")
  standardApiCheck(Intl.DurationFormat.supportedLocalesOf("en").length === 1, "Intl.DurationFormat.supportedLocalesOf")
}
