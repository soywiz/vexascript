import { languageFeatureCheck } from "./checks.vx"

export fun runControlFlowSmoke(): void {
  var total = 0
  featureLoop: for (value of 0 ..< 6) {
    if (value === 2) continue featureLoop
    if (value === 5) break featureLoop
    total += value
  }
  languageFeatureCheck(total === 8, "control-flow.labeled-loop")

  val selected = match (total) {
    8 -> "matched"
    else -> "missed"
  }
  languageFeatureCheck(selected === "matched", "control-flow.match-expression")
}
