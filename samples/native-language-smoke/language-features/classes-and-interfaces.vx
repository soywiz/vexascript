import { languageFeatureCheck } from "./checks.vx"

interface NamedFeature {
  val name: string
  fun describe(prefix: string): string
}

class NamedFeatureImpl(val name: string) : NamedFeature {
  override fun describe(prefix: string): string => `${prefix}:${name}`
}

export fun runClassAndInterfaceSmoke(): void {
  val feature: NamedFeature = NamedFeatureImpl("class")
  languageFeatureCheck(feature.name === "class", "class.interface-property")
  languageFeatureCheck(feature.describe("language") === "language:class", "class.interface-method")
}
