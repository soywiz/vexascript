import { languageFeatureCheck } from "./checks.vx"

class LanguageFeatureBox<T>(val value: T)

fun <T> languageFeatureIdentity(value: T): T => value

export fun runGenericSmoke(): void {
  val boxed = LanguageFeatureBox(languageFeatureIdentity("generic"))
  languageFeatureCheck(boxed.value === "generic", "generics.class-and-function")
}
