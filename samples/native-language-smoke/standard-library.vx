import { runArraySmoke } from "./standard-library/arrays.vx"
import { runAtomicsSmoke } from "./standard-library/atomics.vx"
import { runBinaryDataSmoke } from "./standard-library/binary-data.vx"
import { runCollectionSmoke } from "./standard-library/collections.vx"
import { runDateSmoke } from "./standard-library/date.vx"
import { runErrorSmoke } from "./standard-library/errors.vx"
import { runGlobalValueSmoke } from "./standard-library/globals.vx"
import { runIntlSmoke } from "./standard-library/intl.vx"
import { runIteratorSmoke } from "./standard-library/iterators.vx"
import { runJsonBigIntAndGlobalFunctionSmoke } from "./standard-library/json-bigint-globals.vx"
import { runMathSmoke } from "./standard-library/math.vx"
import { runObjectAndPrimitiveSmoke } from "./standard-library/objects.vx"
import { runPromiseSmoke } from "./standard-library/promises.vx"
import { runRegExpSmoke } from "./standard-library/regexp.vx"
import { runStringSmoke } from "./standard-library/strings.vx"
import { runSyntaxSmoke } from "./standard-library/syntax.vx"
import { runTypedArraySmoke } from "./standard-library/typed-arrays.vx"

/** Runs declaration-locked standard-library calls without changing smoke output. */
export async fun runNativeStandardLibrarySmoke(): Promise<void> {
  await runSyntaxSmoke()
  await runGlobalValueSmoke()
  runMathSmoke()
  runArraySmoke()
  runStringSmoke()
  runObjectAndPrimitiveSmoke()
  runDateSmoke()
  runErrorSmoke()
  runRegExpSmoke()
  runJsonBigIntAndGlobalFunctionSmoke()
  runBinaryDataSmoke()
  runCollectionSmoke()
  await runPromiseSmoke()
  runAtomicsSmoke()
  runIteratorSmoke()
  runTypedArraySmoke()
  runIntlSmoke()
}
