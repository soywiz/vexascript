fun standardApiCheck(condition: boolean, name: string): void {
  if (!condition) {
    console.log("standard library failure", name)
    throw Error(`Standard library smoke failed: ${name}`)
  }
}

fun standardApiNear(actual: number, expected: number, name: string): void {
  standardApiCheck(Math.abs(actual - expected) < 0.000001, name)
}

sync fun invokeSyncBraceLambda(callback: (value: int) => int): int {
  return callback(2)
}

async fun invokeAsyncBraceLambda(callback: (value: int) => Promise<int>): Promise<int> {
  return await callback(2)
}

/** Runs declaration-locked standard-library calls without changing smoke output. */
export async fun runNativeStandardLibrarySmoke(): Promise<void> {
  standardApiCheck(await invokeSyncBraceLambda(sync { it + 1 }) === 3, "syntax.sync-brace-lambda")
  standardApiCheck(await invokeAsyncBraceLambda(async { Promise.resolve(it + 2) }) === 4, "syntax.async-brace-lambda")
  standardApiNear(Math.E, 2.718281828459045, "Math.E")
  standardApiNear(Math.LN10, 2.302585092994046, "Math.LN10")
  standardApiNear(Math.LN2, 0.6931471805599453, "Math.LN2")
  standardApiNear(Math.LOG10E, 0.4342944819032518, "Math.LOG10E")
  standardApiNear(Math.LOG2E, 1.4426950408889634, "Math.LOG2E")
  standardApiNear(Math.PI, 3.141592653589793, "Math.PI")
  standardApiNear(Math.SQRT1_2, 0.7071067811865476, "Math.SQRT1_2")
  standardApiNear(Math.SQRT2, 1.4142135623730951, "Math.SQRT2")
  standardApiCheck(Math.abs(-3) === 3, "Math.abs")
  standardApiNear(Math.acos(1), 0, "Math.acos")
  standardApiNear(Math.acosh(1), 0, "Math.acosh")
  standardApiNear(Math.asin(0), 0, "Math.asin")
  standardApiNear(Math.asinh(0), 0, "Math.asinh")
  standardApiNear(Math.atan(0), 0, "Math.atan")
  standardApiNear(Math.atan2(0, 1), 0, "Math.atan2")
  standardApiNear(Math.atanh(0), 0, "Math.atanh")
  standardApiNear(Math.cbrt(27), 3, "Math.cbrt")
  standardApiCheck(Math.ceil(1.2) === 2, "Math.ceil")
  standardApiCheck(Math.clz32(1) === 31, "Math.clz32")
  standardApiNear(Math.cos(0), 1, "Math.cos")
  standardApiNear(Math.cosh(0), 1, "Math.cosh")
  standardApiNear(Math.exp(0), 1, "Math.exp")
  standardApiNear(Math.expm1(0), 0, "Math.expm1")
  // Node 22 does not expose this ES2025 API yet. The native runtime does, so
  // keep its declaration-locked execution in the native portability smoke.
  if (vexaRuntime() === "native") {
    standardApiCheck(Math.f16round(1.337) === 1.3369140625, "Math.f16round")
  }
  standardApiCheck(Math.floor(1.8) === 1, "Math.floor")
  standardApiNear(Math.fround(1.337), 1.337, "Math.fround")
  standardApiNear(Math.hypot(3, 4, 12), 13, "Math.hypot")
  standardApiCheck(Math.imul(2147483647, 2) === -2, "Math.imul")
  standardApiNear(Math.log(1), 0, "Math.log")
  standardApiNear(Math.log10(100), 2, "Math.log10")
  standardApiNear(Math.log1p(0), 0, "Math.log1p")
  standardApiNear(Math.log2(8), 3, "Math.log2")
  standardApiCheck(Math.max(1, 4, 2) === 4, "Math.max")
  standardApiCheck(Math.min(1, -4, 2) === -4, "Math.min")
  standardApiNear(Math.pow(3, 2), 9, "Math.pow")
  val random = Math.random()
  standardApiCheck(random >= 0 && random <= 1, "Math.random")
  standardApiCheck(Math.round(2.6) === 3, "Math.round")
  standardApiCheck(Math.sign(-4) === -1, "Math.sign")
  standardApiNear(Math.sin(0), 0, "Math.sin")
  standardApiNear(Math.sinh(0), 0, "Math.sinh")
  standardApiNear(Math.sqrt(9), 3, "Math.sqrt")
  standardApiNear(Math.tan(0), 0, "Math.tan")
  standardApiNear(Math.tanh(0), 0, "Math.tanh")
  standardApiCheck(Math.trunc(2.9) === 2, "Math.trunc")

  val array = [1, 2, 3]
  standardApiCheck(array.length === 3, "Array.length")
  standardApiCheck(array.at(-1) === 3, "Array.at")
  standardApiCheck(array.concat(4).join(",") === "1,2,3,4", "Array.concat")
  standardApiCheck([1, 2, 3, 4].copyWithin(1, 2).join(",") === "1,3,4,4", "Array.copyWithin")
  standardApiCheck(array.every((value) => value > 0), "Array.every")
  var arrayEntryCount = 0
  for (val entry of array.entries()) arrayEntryCount += 1
  standardApiCheck(arrayEntryCount === 3, "Array.entries")
  standardApiCheck([1, 2, 3].fill(8, 1).join(",") === "1,8,8", "Array.fill")
  standardApiCheck(array.filter((value) => value % 2 === 1).join(",") === "1,3", "Array.filter")
  standardApiCheck(array.find((value) => value === 2) === 2, "Array.find")
  standardApiCheck(array.findIndex((value) => value === 2) === 1, "Array.findIndex")
  standardApiCheck([[1], [2, 3]].flat().join(",") === "1,2,3", "Array.flat")
  standardApiCheck(array.flatMap((value) => [value, value]).length === 6, "Array.flatMap")
  var forEachTotal = 0
  array.forEach((value) => forEachTotal += value)
  standardApiCheck(forEachTotal === 6, "Array.forEach")
  standardApiCheck(array.includes(2), "Array.includes")
  standardApiCheck(array.indexOf(2) === 1, "Array.indexOf")
  standardApiCheck(array.join("|") === "1|2|3", "Array.join")
  standardApiCheck([...array.keys()].join(",") === "0,1,2", "Array.keys")
  standardApiCheck([1, 2, 1].lastIndexOf(1) === 2, "Array.lastIndexOf")
  standardApiCheck(array.map((value) => value * 2).join(",") === "2,4,6", "Array.map")
  val popped = [1, 2]
  standardApiCheck(popped.pop() === 2, "Array.pop")
  val pushed = [1]
  standardApiCheck(pushed.push(2) === 2, "Array.push")
  standardApiCheck(array.reduce((total, value) => total + value, 0) === 6, "Array.reduce")
  standardApiCheck(array.reduceRight((total, value) => total * 10 + value, 0) === 321, "Array.reduceRight")
  standardApiCheck([1, 2, 3].reverse().join(",") === "3,2,1", "Array.reverse")
  val shifted = [1, 2]
  standardApiCheck(shifted.shift() === 1, "Array.shift")
  standardApiCheck(array.slice(1).join(",") === "2,3", "Array.slice")
  standardApiCheck(array.some((value) => value === 2), "Array.some")
  standardApiCheck([3, 1, 2].sort().join(",") === "1,2,3", "Array.sort")
  val spliced = [1, 2, 3]
  standardApiCheck(spliced.splice(1, 1, 8).join(",") === "2" && spliced.join(",") === "1,8,3", "Array.splice")
  val arrayText = array.toString()
  standardApiCheck(arrayText === "1,2,3" || arrayText === "[1, 2, 3]", "Array.toString")
  val localizedArrayText = array.toLocaleString()
  standardApiCheck(localizedArrayText === "1,2,3" || localizedArrayText === "[1, 2, 3]", "Array.toLocaleString")
  val unshifted = [2, 3]
  standardApiCheck(unshifted.unshift(1) === 3 && unshifted[0] === 1, "Array.unshift")
  standardApiCheck(Array.isArray(array) === true, "Array.isArray")
  standardApiCheck(Array.from(array).join(",") === "1,2,3", "Array.from")
  standardApiCheck(Array.of(1, 2, 3).join(",") === "1,2,3", "Array.of")
  standardApiCheck([...array.values()].join(",") === "1,2,3", "Array.values")

  val text = "  VexaScript  "
  standardApiCheck(text.length === 14, "String.length")
  standardApiCheck("abc".at(-1) === "c", "String.at")
  standardApiCheck("abc".charAt(1) === "b", "String.charAt")
  standardApiCheck("abc".charCodeAt(1) === 98, "String.charCodeAt")
  standardApiCheck("😀".codePointAt(0) === 128512, "String.codePointAt")
  standardApiCheck("a".concat("b", "c") === "abc", "String.concat")
  standardApiCheck("abc".endsWith("bc"), "String.endsWith")
  standardApiCheck("abc".includes("b"), "String.includes")
  standardApiCheck("abc".indexOf("b") === 1, "String.indexOf")
  standardApiCheck("abca".lastIndexOf("a") === 3, "String.lastIndexOf")
  standardApiCheck("ab".repeat(2) === "abab", "String.repeat")
  standardApiCheck("aba".replace("a", "x") === "xba", "String.replace")
  standardApiCheck("abc".slice(1) === "bc", "String.slice")
  standardApiCheck("abc".slice() === "abc", "String.slice default start")
  standardApiCheck("a,b".split(",").join("|") === "a|b", "String.split")
  standardApiCheck("abc".startsWith("ab"), "String.startsWith")
  standardApiCheck("abc".substring(1, 3) === "bc", "String.substring")
  standardApiCheck("VEXA".toLowerCase() === "vexa", "String.toLowerCase")
  standardApiCheck("vexa".toUpperCase() === "VEXA", "String.toUpperCase")
  standardApiCheck("VEXA".toLocaleLowerCase() === "vexa", "String.toLocaleLowerCase")
  standardApiCheck("vexa".toLocaleUpperCase() === "VEXA", "String.toLocaleUpperCase")
  standardApiCheck("vexa".toString() === "vexa", "String.toString")
  standardApiCheck("vexa".valueOf() === "vexa", "String.valueOf")
  standardApiCheck(" x ".trim() === "x", "String.trim")
  standardApiCheck(" x ".trimEnd() === " x", "String.trimEnd")
  standardApiCheck(" x ".trimStart() === "x ", "String.trimStart")
  standardApiCheck(" x ".trimLeft() === "x ", "String.trimLeft")
  standardApiCheck(" x ".trimRight() === " x", "String.trimRight")
  standardApiCheck(String.fromCharCode(65) === "A", "String.fromCharCode")

  standardApiCheck(true.valueOf(), "Boolean.valueOf")
  standardApiCheck((12.5).toFixed(1) === "12.5", "Number.toFixed")
  standardApiCheck((12).toString() === "12", "Number.toString")
  standardApiCheck((12).valueOf() === 12, "Number.valueOf")
  standardApiCheck((12).toLocaleString() === "12", "Number.toLocaleString")
  standardApiCheck(Number.isFinite(12), "Number.isFinite")
  standardApiCheck(Number.isInteger(12), "Number.isInteger")
  standardApiCheck(Number.isNaN(parseFloat("not-a-number")), "Number.isNaN")

  val object = { first: 1, second: 2 }
  standardApiCheck(Object.keys(object).join(",") === "first,second", "Object.keys")
  standardApiCheck(Object.values(object).join(",") === "1,2", "Object.values")
  standardApiCheck(Object.entries(object).length === 2, "Object.entries")
  standardApiCheck(Object.fromEntries([["answer", 42]]).answer === 42, "Object.fromEntries")
  val defined: { visible?: number } = {}
  Object.defineProperty(defined, "visible", { value: 7, enumerable: true })
  standardApiCheck(defined.visible === 7, "Object.defineProperty")

  val date = new Date(0)
  standardApiCheck(date.getTime() === 0, "Date.getTime")
  standardApiCheck(date.valueOf() === 0, "Date.valueOf")
  standardApiCheck(date.getUTCFullYear() === 1970, "Date.getUTCFullYear")
  standardApiCheck(date.getUTCMonth() === 0, "Date.getUTCMonth")
  standardApiCheck(date.getUTCDate() === 1, "Date.getUTCDate")
  standardApiCheck(date.getUTCDay() === 4, "Date.getUTCDay")
  standardApiCheck(date.getUTCHours() === 0, "Date.getUTCHours")
  standardApiCheck(date.getUTCMinutes() === 0, "Date.getUTCMinutes")
  standardApiCheck(date.getUTCSeconds() === 0, "Date.getUTCSeconds")
  standardApiCheck(date.getUTCMilliseconds() === 0, "Date.getUTCMilliseconds")
  standardApiCheck(date.toISOString() === "1970-01-01T00:00:00.000Z", "Date.toISOString")
  standardApiCheck(date.toString().length > 0, "Date.toString")
  standardApiCheck(date.toJSON() === "1970-01-01T00:00:00.000Z", "Date.toJSON")
  standardApiCheck(Date.parse("1970-01-01") === 0, "Date.parse")
  standardApiCheck(Date.now() > 0, "Date.now")

  val expression = /a/i
  standardApiCheck(expression.test("A"), "RegExp.test")
  standardApiCheck(expression.exec("A")?.[0] === "A", "RegExp.exec")
  standardApiCheck(expression.source === "a", "RegExp.source")
  standardApiCheck(expression.flags === "i", "RegExp.flags")
  standardApiCheck(expression.ignoreCase, "RegExp.ignoreCase")
  standardApiCheck(!expression.global, "RegExp.global")
  standardApiCheck(!expression.multiline, "RegExp.multiline")
  standardApiCheck(!expression.dotAll, "RegExp.dotAll")
  standardApiCheck(!expression.sticky, "RegExp.sticky")
  standardApiCheck(!expression.unicode, "RegExp.unicode")
  standardApiCheck(!expression.unicodeSets, "RegExp.unicodeSets")
  standardApiCheck(!expression.hasIndices, "RegExp.hasIndices")
  standardApiCheck(expression.lastIndex === 0, "RegExp.lastIndex")

  standardApiCheck(JSON.parse("{\"value\":7}").value === 7, "JSON.parse")
  standardApiCheck(JSON.stringify({ value: 7 }) === "{\"value\":7}", "JSON.stringify")
  val apiError = Error("api")
  standardApiCheck(apiError.message === "api", "Error.message")
  standardApiCheck(performance.now() >= 0, "Performance.now")
  standardApiCheck(isNaN(NaN), "global.NaN")
  standardApiCheck(isFinite(Infinity) === false, "global.Infinity")
  standardApiCheck(parseInt("12", 10) === 12, "global.parseInt")
  standardApiCheck(parseFloat("1.5") === 1.5, "global.parseFloat")
  standardApiCheck(isNaN(parseFloat("x")), "global.isNaN")
  standardApiCheck(isFinite(12), "global.isFinite")
  standardApiCheck(encodeURIComponent("a b") === "a%20b", "global.encodeURIComponent")
  standardApiCheck(decodeURIComponent("a%20b") === "a b", "global.decodeURIComponent")
  standardApiCheck(encodeURI("a b") === "a%20b", "global.encodeURI")
  standardApiCheck(decodeURI("a%20b") === "a b", "global.decodeURI")
  standardApiCheck(escape("a b") === "a%20b", "global.escape")
  standardApiCheck(unescape("a%20b") === "a b", "global.unescape")
  val big = BigInt("255")
  standardApiCheck(big.toString() === "255", "BigInt.toString")
  standardApiCheck(big.toLocaleString() === "255", "BigInt.toLocaleString")
  standardApiCheck(big.valueOf() === 255n, "BigInt.valueOf")
  standardApiCheck(BigInt.asUintN(8, 257n) === 1n, "BigInt.asUintN")
  standardApiCheck(BigInt.asIntN(8, 255n) === -1n, "BigInt.asIntN")

  val buffer = new ArrayBuffer(32)
  standardApiCheck(buffer.byteLength === 32, "ArrayBuffer.byteLength")
  standardApiCheck(buffer.maxByteLength === 32, "ArrayBuffer.maxByteLength")
  standardApiCheck(!buffer.resizable, "ArrayBuffer.resizable")
  standardApiCheck(!buffer.detached, "ArrayBuffer.detached")
  standardApiCheck(buffer.slice(4, 12).byteLength === 8, "ArrayBuffer.slice")
  val view = new DataView(buffer)
  standardApiCheck(view.buffer === buffer, "DataView.buffer")
  standardApiCheck(view.byteLength === 32, "DataView.byteLength")
  standardApiCheck(view.byteOffset === 0, "DataView.byteOffset")
  view.setInt8(0, 127)
  standardApiCheck(view.getInt8(0) === 127, "DataView.setInt8")
  standardApiCheck(view.getInt8(0) === 127, "DataView.getInt8")
  view.setUint8(1, 255)
  standardApiCheck(view.getUint8(1) === 255, "DataView.setUint8")
  standardApiCheck(view.getUint8(1) === 255, "DataView.getUint8")
  view.setInt16(2, 123, true)
  standardApiCheck(view.getInt16(2, true) === 123, "DataView.setInt16")
  standardApiCheck(view.getInt16(2, true) === 123, "DataView.getInt16")
  view.setUint16(4, 65535, true)
  standardApiCheck(view.getUint16(4, true) === 65535, "DataView.setUint16")
  standardApiCheck(view.getUint16(4, true) === 65535, "DataView.getUint16")
  view.setInt32(8, 123456, true)
  standardApiCheck(view.getInt32(8, true) === 123456, "DataView.setInt32")
  standardApiCheck(view.getInt32(8, true) === 123456, "DataView.getInt32")
  view.setUint32(12, 4294967295, true)
  standardApiCheck(view.getUint32(12, true) === 4294967295, "DataView.setUint32")
  standardApiCheck(view.getUint32(12, true) === 4294967295, "DataView.getUint32")
  view.setFloat32(16, 1.5, true)
  standardApiCheck(view.getFloat32(16, true) === 1.5, "DataView.setFloat32")
  standardApiCheck(view.getFloat32(16, true) === 1.5, "DataView.getFloat32")
  view.setFloat64(20, 2.5, true)
  standardApiCheck(view.getFloat64(20, true) === 2.5, "DataView.setFloat64")
  standardApiCheck(view.getFloat64(20, true) === 2.5, "DataView.getFloat64")
  val bytes = new Uint8Array(buffer)
  standardApiCheck(bytes.buffer === buffer, "Uint8Array.buffer")
  standardApiCheck(bytes.byteLength === 32, "Uint8Array.byteLength")
  standardApiCheck(bytes.byteOffset === 0, "Uint8Array.byteOffset")
  standardApiCheck(bytes.length === 32, "Uint8Array.length")
  standardApiCheck(ArrayBuffer.isView(bytes) === true, "ArrayBuffer.isView")
  val words = new Uint32Array(2)
  standardApiCheck(words.byteLength === 8, "Uint32Array.byteLength")
  standardApiCheck(words.byteOffset === 0, "Uint32Array.byteOffset")
  standardApiCheck(words.length === 2, "Uint32Array.length")
  standardApiCheck(words.buffer.byteLength === 8, "Uint32Array.buffer")
  val signedWords = new Int32Array(2)
  standardApiCheck(signedWords.byteLength === 8, "Int32Array.byteLength")
  standardApiCheck(signedWords.byteOffset === 0, "Int32Array.byteOffset")
  standardApiCheck(signedWords.length === 2, "Int32Array.length")
  standardApiCheck(signedWords.buffer.byteLength === 8, "Int32Array.buffer")

  val map = new Map<string, number>()
  standardApiCheck(map.size === 0, "Map.size")
  standardApiCheck(map.set("one", 1) === map, "Map.set")
  standardApiCheck(map.get("one") === 1, "Map.get")
  standardApiCheck(map.has("one"), "Map.has")
  standardApiCheck([...map.keys()].join(",") === "one", "Map.keys")
  standardApiCheck([...map.values()].join(",") === "1", "Map.values")
  standardApiCheck([...map.entries()].length === 1, "Map.entries")
  var mapTotal: number = 0
  map.forEach((value) => mapTotal += value)
  standardApiCheck(mapTotal === 1, "Map.forEach")
  standardApiCheck(map.delete("one"), "Map.delete")
  map.set("two", 2)
  map.clear()
  standardApiCheck(map.size === 0, "Map.clear")

  val set = new Set<number>()
  standardApiCheck(set.size === 0, "Set.size")
  standardApiCheck(set.add(1) === set, "Set.add")
  standardApiCheck(set.has(1), "Set.has")
  standardApiCheck([...set.keys()].join(",") === "1", "Set.keys")
  standardApiCheck([...set.values()].join(",") === "1", "Set.values")
  var setEntryCount = 0
  for (val entry of set.entries()) setEntryCount += 1
  standardApiCheck(setEntryCount === 1, "Set.entries")
  var setTotal: number = 0
  set.forEach((value) => setTotal += value)
  standardApiCheck(setTotal === 1, "Set.forEach")
  standardApiCheck(set.delete(1), "Set.delete")
  set.add(2)
  set.clear()
  standardApiCheck(set.size === 0, "Set.clear")

  val weakKey = { id: 1 }
  val weakMap = new WeakMap<object, number>()
  standardApiCheck(weakMap.set(weakKey, 7) === weakMap, "WeakMap.set")
  standardApiCheck(weakMap.get(weakKey) === 7, "WeakMap.get")
  standardApiCheck(weakMap.has(weakKey), "WeakMap.has")
  standardApiCheck(weakMap.delete(weakKey), "WeakMap.delete")
  val weakSet = new WeakSet<object>()
  standardApiCheck(weakSet.add(weakKey) === weakSet, "WeakSet.add")
  standardApiCheck(weakSet.has(weakKey), "WeakSet.has")
  standardApiCheck(weakSet.delete(weakKey), "WeakSet.delete")

  standardApiCheck(await Promise.resolve(3) === 3, "Promise.resolve")
  standardApiCheck(await Promise.reject("rejected").catch((reason: any) => reason) === "rejected", "Promise.reject")
  standardApiCheck(await Promise.resolve(3).then((value) => value + 1) === 4, "Promise.then")
  standardApiCheck(await Promise.reject("caught").catch((reason: any) => reason) === "caught", "Promise.catch")
  var finalized = false
  await Promise.resolve(1).finally(() => finalized = true)
  standardApiCheck(finalized, "Promise.finally")
  standardApiCheck((await Promise.all([Promise.resolve(1), Promise.resolve(2)])).join(",") === "1,2", "Promise.all")
  standardApiCheck((await Promise.allSettled([Promise.resolve(1)])).length === 1, "Promise.allSettled")
  standardApiCheck(await Promise.any([Promise.reject("ignored"), Promise.resolve(4)]) === 4, "Promise.any")
  standardApiCheck(await Promise.race([Promise.resolve(5), Promise.resolve(6)]) === 5, "Promise.race")

  val atomics = new Int32Array(new SharedArrayBuffer(16))
  Atomics.store(atomics, 0, 7)
  standardApiCheck(Atomics.add(atomics, 0, 1) === 7, "Atomics.add")
  standardApiCheck(Atomics.sub(atomics, 0, 2) === 8, "Atomics.sub")
  standardApiCheck(Atomics.and(atomics, 0, 3) === 6, "Atomics.and")
  standardApiCheck(Atomics.or(atomics, 0, 4) === 2, "Atomics.or")
  standardApiCheck(Atomics.xor(atomics, 0, 1) === 6, "Atomics.xor")
  standardApiCheck(Atomics.exchange(atomics, 0, 9) === 7, "Atomics.exchange")
  standardApiCheck(Atomics.compareExchange(atomics, 0, 9, 11) === 9, "Atomics.compareExchange")
  standardApiCheck(Atomics.load(atomics, 0) === 11, "Atomics.load")
  standardApiCheck(Atomics.isLockFree(4), "Atomics.isLockFree")
  standardApiCheck(Atomics.notify(atomics, 0) === 0, "Atomics.notify")
  standardApiCheck(Atomics.wait(atomics, 0, 12, 0) === "not-equal", "Atomics.wait")

  val iteratorValues = [1, 2, 3, 4]
  standardApiCheck(Iterator.from(iteratorValues).map((value) => value * 2).toArray().join(",") === "2,4,6,8", "Iterator.map")
  standardApiCheck(Iterator.from(iteratorValues).filter((value) => value % 2 === 0).toArray().join(",") === "2,4", "Iterator.filter")
  standardApiCheck(Iterator.from(iteratorValues).take(2).toArray().join(",") === "1,2", "Iterator.take")
  standardApiCheck(Iterator.from(iteratorValues).drop(2).toArray().join(",") === "3,4", "Iterator.drop")
  standardApiCheck(Iterator.from(iteratorValues).flatMap((value) => [value, value]).toArray().length === 8, "Iterator.flatMap")
  standardApiCheck(Iterator.from(iteratorValues).reduce((total, value) => total + value, 0) === 10, "Iterator.reduce")
  standardApiCheck(Iterator.from(iteratorValues).toArray().length === 4, "Iterator.toArray")
  var iteratorTotal = 0
  Iterator.from(iteratorValues).forEach((value) => iteratorTotal += value)
  standardApiCheck(iteratorTotal === 10, "Iterator.forEach")
  standardApiCheck(Iterator.from(iteratorValues).some((value) => value === 3), "Iterator.some")
  standardApiCheck(Iterator.from(iteratorValues).every((value) => value > 0), "Iterator.every")
  standardApiCheck(Iterator.from(iteratorValues).find((value) => value === 3) === 3, "Iterator.find")
  standardApiCheck(Iterator.from(iteratorValues).toArray().length === 4, "Iterator.from")

  val modernArray = [1, 2, 3, 2]
  standardApiCheck(modernArray.findLast((value) => value === 2) === 2, "Array.findLast")
  standardApiCheck(modernArray.findLastIndex((value) => value === 2) === 3, "Array.findLastIndex")
  standardApiCheck(modernArray.toReversed().join(",") === "2,3,2,1", "Array.toReversed")
  standardApiCheck(modernArray.toSorted((left, right) => right - left).join(",") === "3,2,2,1", "Array.toSorted")
  standardApiCheck(modernArray.toSpliced(1, 2, 8, 9).join(",") === "1,8,9,2", "Array.toSpliced")
  standardApiCheck(modernArray.with(1, 7).join(",") === "1,7,3,2", "Array.with")

  val setLeft = new Set<number>([1, 2, 3])
  val setRight = new Set<number>([3, 4])
  standardApiCheck([...setLeft.union(setRight)].join(",") === "1,2,3,4", "Set.union")
  standardApiCheck([...setLeft.intersection(setRight)].join(",") === "3", "Set.intersection")
  standardApiCheck([...setLeft.difference(setRight)].join(",") === "1,2", "Set.difference")
  standardApiCheck([...setLeft.symmetricDifference(setRight)].join(",") === "1,2,4", "Set.symmetricDifference")
  standardApiCheck(new Set<number>([1, 2]).isSubsetOf(setLeft), "Set.isSubsetOf")
  standardApiCheck(setLeft.isSupersetOf(new Set<number>([1, 2])), "Set.isSupersetOf")
  standardApiCheck(setLeft.isDisjointFrom(new Set<number>([8, 9])), "Set.isDisjointFrom")
  val objectGroups = Object.groupBy([1, 2, 3, 4], (value) => value % 2 === 0 ? "even" : "odd")
  standardApiCheck(Object.keys(objectGroups).includes("even"), "Object.groupBy")
  val mapGroups = Map.groupBy([1, 2, 3, 4], (value) => value % 2)
  standardApiCheck(mapGroups.get(1)?.join(",") === "1,3", "Map.groupBy")

  val resolvers = Promise.withResolvers<number>()
  resolvers.resolve(6)
  standardApiCheck(await resolvers.promise === 6, "Promise.withResolvers")

  standardApiCheck("aba".replaceAll("a", "x") === "xbx", "String.replaceAll")
  standardApiCheck("A😀".isWellFormed(), "String.isWellFormed")
  standardApiCheck(String.fromCharCode(0xd800).toWellFormed() === "�", "String.toWellFormed")

  // Node 22 does not expose these ES2025 APIs yet. Keep their declaration-locked
  // execution in the native portability smoke, where all are implemented.
  if (vexaRuntime() === "native") {
    standardApiCheck(await Promise.try(() => 5) === 5, "Promise.try")
    standardApiCheck(RegExp.escape("a+b") === "\\x61\\+b", "RegExp.escape")

    val halves = Float16Array.of(1.5, 2.25, 3.75)
    standardApiCheck(halves.length === 3, "Float16Array.length")
    standardApiCheck(halves[1] === 2.25, "Float16Array.of")
    val mappedHalves = Float16Array.from([1, 2], (value) => value + 0.5)
    standardApiCheck(mappedHalves.join(",") === "1.5,2.5", "Float16Array.join")
    standardApiCheck(mappedHalves.length === 2, "Float16Array.from")

    val duration = new Intl.DurationFormat("en", { style: "short" })
    standardApiCheck((duration.format({ hours: 1, minutes: 2 }) as string).length > 0, "Intl.DurationFormat.format")
    standardApiCheck((duration.formatToParts({ seconds: 3 }) as unknown[]).length > 0, "Intl.DurationFormat.formatToParts")
    standardApiCheck((duration.resolvedOptions() as { style: string }).style === "short", "Intl.DurationFormat.resolvedOptions")
  }

  val sharedBuffer = new SharedArrayBuffer(8, { maxByteLength: 16 })
  standardApiCheck(sharedBuffer.byteLength === 8, "SharedArrayBuffer.byteLength")
  standardApiCheck(sharedBuffer.growable, "SharedArrayBuffer.growable")
  standardApiCheck(sharedBuffer.maxByteLength === 16, "SharedArrayBuffer.maxByteLength")
  standardApiCheck(sharedBuffer.slice(0, 4).byteLength === 4, "SharedArrayBuffer.slice")
  sharedBuffer.grow(16)
  standardApiCheck(sharedBuffer.byteLength === 16, "SharedArrayBuffer.grow")
  standardApiCheck(Atomics.store(atomics, 1, 4) === 4, "Atomics.store")
  val waited = Atomics.waitAsync(atomics, 1, 8, 0)
  standardApiCheck(waited != null, "Atomics.waitAsync")
}
