import { runClassAndInterfaceSmoke } from "./language-features/classes-and-interfaces.vx"
import { runControlFlowSmoke } from "./language-features/control-flow.vx"
import { runCustomOperatorSmoke } from "./language-features/custom-operators.vx"
import { runGenericSmoke } from "./language-features/generics.vx"

/** Runs focused language-feature checks separately from the ECMAScript runtime surface. */
export fun runNativeLanguageFeatureSmoke(): void {
  runClassAndInterfaceSmoke()
  runControlFlowSmoke()
  runGenericSmoke()
  runCustomOperatorSmoke()
}
